{
  "schemaVersion": "1.0.0",
  "id": "attendees",
  "version": "1.0.0",
  "kind": "surface",
  "title": "{{t('attendees.title')}}",
  "description": "{{t('attendees.description')}}",
  "path": {
    "tr": "katilimcilar"
  },
  "blocks": [
    {
      "id": "out",
      "type": "container",
      "props": {
        "direction": "column",
        "gap": 16,
        "padding": 0
      },
      "children": [
        {
          "id": "out-head",
          "type": "section",
          "props": {
            "paddingY": 32,
            "gap": 8,
            "textAlign": "left"
          },
          "children": [
            {
              "id": "out-t",
              "type": "heading",
              "props": {
                "text": "{{t('attendees.heading')}}",
                "level": "h1"
              }
            },
            {
              "id": "out-s",
              "type": "text",
              "props": {
                "content": "{{t('attendees.signIn.lead')}}",
                "color": "var(--pw-color-text-muted)"
              }
            }
          ],
          "style": {
            "paddingBottom": "0"
          }
        },
        {
          "id": "out-in",
          "type": "button",
          "props": {
            "label": "{{t('signIn.submit')}}",
            "variant": "primary",
            "icon": "log-in",
            "action": {
              "type": "auth:signIn",
              "method": "password"
            }
          },
          "style": {
            "alignSelf": "flex-start"
          }
        }
      ],
      "visibleWhen": "{{!__auth.signedIn}}",
      "style": {
        "paddingBottom": "40px"
      }
    },
    {
      "id": "other",
      "type": "container",
      "props": {
        "direction": "column",
        "gap": 12,
        "padding": 0
      },
      "children": [
        {
          "id": "other-head",
          "type": "section",
          "props": {
            "paddingY": 32,
            "gap": 8,
            "textAlign": "left"
          },
          "children": [
            {
              "id": "other-t",
              "type": "heading",
              "props": {
                "text": "{{t('attendees.other.title')}}",
                "level": "h1"
              }
            },
            {
              "id": "other-s",
              "type": "text",
              "props": {
                "content": "{{t('attendees.other.body')}}",
                "color": "var(--pw-color-text-muted)"
              }
            }
          ]
        },
        {
          "id": "other-out",
          "type": "button",
          "props": {
            "label": "{{t('signOut')}}",
            "variant": "outline",
            "action": {
              "type": "auth:signOut"
            }
          },
          "style": {
            "alignSelf": "flex-start"
          }
        }
      ],
      "visibleWhen": "{{__auth.signedIn && !includes(me.roles, 'organiser')}}",
      "style": {
        "paddingBottom": "40px"
      }
    },
    {
      "id": "desk",
      "type": "container",
      "props": {
        "direction": "column",
        "gap": 16,
        "padding": 0
      },
      "children": [
        {
          "id": "desk-head",
          "type": "container",
          "props": {
            "direction": "row",
            "gap": 12,
            "padding": 0,
            "wrap": true,
            "align": "center",
            "justify": "between"
          },
          "children": [
            {
              "id": "desk-title",
              "type": "section",
              "props": {
                "paddingY": 0,
                "gap": 4,
                "textAlign": "left"
              },
              "children": [
                {
                  "id": "desk-t",
                  "type": "heading",
                  "props": {
                    "text": "{{t('attendees.heading')}}",
                    "level": "h1"
                  }
                },
                {
                  "id": "desk-count",
                  "type": "text",
                  "props": {
                    "content": "{{t('attendees.count', isArray(taken) ? first(taken) : taken)}} · {{t('attendees.capacity', meetup.0)}}",
                    "fontWeight": "semibold"
                  }
                }
              ],
              "style": {
                "flex": "1 1 260px"
              }
            },
            {
              "id": "desk-out",
              "type": "button",
              "props": {
                "label": "{{t('signOut')}}",
                "variant": "ghost",
                "action": {
                  "type": "auth:signOut"
                }
              }
            }
          ],
          "style": {
            "paddingTop": "32px"
          }
        },
        {
          "id": "desk-err",
          "type": "alert",
          "props": {
            "variant": "error",
            "title": "{{t('attendees.err.title')}}",
            "message": "{{t('err.retryText')}}"
          },
          "visibleWhen": "{{!!__errors.attendees}}"
        },
        {
          "id": "desk-wait",
          "type": "container",
          "props": {
            "direction": "column",
            "gap": 8,
            "padding": 0
          },
          "children": [
            {
              "id": "desk-wait-1",
              "type": "skeleton",
              "props": {
                "variant": "rectangle",
                "height": 56,
                "width": "100%"
              }
            },
            {
              "id": "desk-wait-2",
              "type": "skeleton",
              "props": {
                "variant": "rectangle",
                "height": 56,
                "width": "100%"
              }
            },
            {
              "id": "desk-wait-3",
              "type": "skeleton",
              "props": {
                "variant": "rectangle",
                "height": 56,
                "width": "100%"
              }
            },
            {
              "id": "desk-wait-4",
              "type": "skeleton",
              "props": {
                "variant": "rectangle",
                "height": 56,
                "width": "100%"
              }
            }
          ],
          "visibleWhen": "{{__loading.attendees && length(attendees) == 0}}"
        },
        {
          "id": "desk-empty",
          "type": "text",
          "props": {
            "content": "{{t('attendees.empty')}}",
            "color": "var(--pw-color-text-muted)"
          },
          "visibleWhen": "{{length(attendees) == 0 && !__loading.attendees && !__errors.attendees}}"
        },
        {
          "id": "desk-list",
          "type": "card",
          "props": {
            "padding": 0,
            "gap": 0,
            "align": "stretch"
          },
          "children": [
            {
              "id": "att",
              "type": "container",
              "props": {
                "direction": "column",
                "gap": 0,
                "padding": 0
              },
              "children": [
                {
                  "id": "att-row",
                  "type": "container",
                  "props": {
                    "direction": "row",
                    "gap": 12,
                    "padding": 0,
                    "wrap": true,
                    "align": "center"
                  },
                  "children": [
                    {
                      "id": "att-n",
                      "type": "text",
                      "props": {
                        "content": "{{index + 1}}",
                        "color": "var(--pw-color-text-muted)"
                      },
                      "style": {
                        "flex": "0 0 2rem",
                        "fontVariantNumeric": "tabular-nums"
                      }
                    },
                    {
                      "id": "att-who",
                      "type": "container",
                      "props": {
                        "direction": "column",
                        "gap": 2,
                        "padding": 0
                      },
                      "children": [
                        {
                          "id": "att-name",
                          "type": "text",
                          "props": {
                            "content": "{{item.name}}",
                            "fontWeight": "semibold"
                          }
                        },
                        {
                          "id": "att-email",
                          "type": "text",
                          "props": {
                            "content": "{{item.email}}",
                            "color": "var(--pw-color-text-muted)"
                          }
                        }
                      ],
                      "style": {
                        "flex": "1 1 200px",
                        "minWidth": "0",
                        "overflowWrap": "anywhere"
                      }
                    },
                    {
                      "id": "att-diet",
                      "type": "badge",
                      "props": {
                        "text": "{{item.diet == 'vegetarian' ? t('diet.vegetarian') : (item.diet == 'vegan' ? t('diet.vegan') : (item.diet == 'glutenFree' ? t('diet.glutenFree') : t('diet.anything')))}}",
                        "variant": "secondary"
                      }
                    },
                    {
                      "id": "att-when",
                      "type": "text",
                      "props": {
                        "content": "{{datetime(item.signedAt, 'short')}}",
                        "color": "var(--pw-color-text-muted)"
                      },
                      "style": {
                        "flex": "0 0 auto",
                        "fontSize": "var(--pw-font-size-sm)"
                      }
                    }
                  ],
                  "style": {
                    "paddingBlock": "12px",
                    "paddingInline": "16px",
                    "borderTop": "1px solid var(--pw-color-border)",
                    "marginTop": "-1px"
                  }
                }
              ],
              "repeat": "{{attendees}}"
            }
          ],
          "visibleWhen": "{{length(attendees) > 0}}",
          "style": {
            "overflow": "hidden"
          }
        }
      ],
      "visibleWhen": "{{__auth.signedIn && includes(me.roles, 'organiser')}}",
      "style": {
        "paddingBottom": "40px"
      }
    }
  ],
  "capabilities": [
    {
      "capability": "platform/persistence",
      "config": {
        "dataSources": [
          {
            "id": "attendees",
            "kind": "entity",
            "entityType": "Signup",
            "requiresSession": true,
            "query": {
              "sort": [
                {
                  "field": "signedAt",
                  "direction": "asc"
                }
              ]
            }
          },
          {
            "id": "taken",
            "kind": "entity",
            "entityType": "Signup",
            "aggregate": {
              "fn": "count"
            },
            "requiresSession": true
          },
          {
            "id": "meetup",
            "kind": "entity",
            "entityType": "Meetup"
          }
        ]
      }
    }
  ],
  "knowledge": {
    "purpose": "The organiser signs in and sees who is coming, with a count against the capacity.",
    "laws": [
      "Signed out, the page is a sign-in form; signed in without the organiser role, it says so",
      "Only the organiser role reads Signup records (auth.json)",
      "The count is one plural message per language"
    ],
    "patternsExercised": [
      "sign-in-inline",
      "data-table"
    ]
  }
}
