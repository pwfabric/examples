{
  "schemaVersion": "1.0.0",
  "id": "speakers",
  "version": "1.0.0",
  "kind": "surface",
  "title": "{{t('speakers.title')}}",
  "description": "{{t('speakers.description')}}",
  "path": {
    "tr": "konusmacilar"
  },
  "blocks": [
    {
      "id": "head",
      "type": "section",
      "props": {
        "paddingY": 32,
        "gap": 8,
        "textAlign": "left"
      },
      "children": [
        {
          "id": "head-t",
          "type": "heading",
          "props": {
            "text": "{{t('speakers.heading')}}",
            "level": "h1"
          }
        },
        {
          "id": "head-s",
          "type": "text",
          "props": {
            "content": "{{t('speakers.lead')}}",
            "color": "var(--pw-color-text-muted)"
          }
        }
      ],
      "style": {
        "paddingBottom": "8px"
      }
    },
    {
      "id": "sp-err",
      "type": "alert",
      "props": {
        "variant": "error",
        "title": "{{t('speakers.err.title')}}",
        "message": "{{t('err.retryText')}}"
      },
      "visibleWhen": "{{!!__errors.speakers}}"
    },
    {
      "id": "sp-wait",
      "type": "grid",
      "props": {
        "columns": 3,
        "columnsXs": 1,
        "gap": 20
      },
      "children": [
        {
          "id": "sp-wait-1",
          "type": "skeleton",
          "props": {
            "variant": "card",
            "height": 420
          }
        },
        {
          "id": "sp-wait-2",
          "type": "skeleton",
          "props": {
            "variant": "card",
            "height": 420
          }
        },
        {
          "id": "sp-wait-3",
          "type": "skeleton",
          "props": {
            "variant": "card",
            "height": 420
          }
        }
      ],
      "visibleWhen": "{{__loading.speakers && length(speakers) == 0}}"
    },
    {
      "id": "sp",
      "type": "grid",
      "props": {
        "columns": 3,
        "columnsXs": 1,
        "gap": 20
      },
      "children": [
        {
          "id": "who",
          "type": "card",
          "props": {
            "padding": 0,
            "gap": 0,
            "align": "stretch"
          },
          "children": [
            {
              "id": "who-pic",
              "type": "image",
              "props": {
                "src": "{{item.image}}",
                "alt": "{{t('speaker.alt', item)}}",
                "width": 320,
                "height": 240,
                "aspectRatio": "4/3",
                "objectFit": "cover"
              },
              "style": {
                "width": "100%",
                "height": "auto"
              }
            },
            {
              "id": "who-body",
              "type": "container",
              "props": {
                "direction": "column",
                "gap": 8,
                "padding": 20
              },
              "children": [
                {
                  "id": "who-name",
                  "type": "heading",
                  "props": {
                    "text": "{{item.name}}",
                    "level": "h2"
                  }
                },
                {
                  "id": "who-role",
                  "type": "text",
                  "props": {
                    "content": "{{t('speaker.role', item)}}",
                    "color": "var(--pw-color-primary)",
                    "fontWeight": "semibold"
                  }
                },
                {
                  "id": "who-bio",
                  "type": "text",
                  "props": {
                    "content": "{{t('speaker.bio', item)}}",
                    "color": "var(--pw-color-text-muted)"
                  }
                },
                {
                  "id": "who-talk",
                  "type": "text",
                  "props": {
                    "content": "{{t('speaker.talk', find(talks, 'speaker', item.id))}}",
                    "fontWeight": "semibold"
                  }
                }
              ]
            }
          ]
        }
      ],
      "repeat": "{{speakers}}",
      "visibleWhen": "{{length(speakers) > 0}}",
      "style": {
        "paddingBottom": "24px"
      }
    },
    {
      "id": "sp-cta",
      "type": "button",
      "props": {
        "label": "{{t('cta.signup')}}",
        "href": "/signup",
        "variant": "primary",
        "icon": "calendar"
      },
      "style": {
        "alignSelf": "flex-start",
        "marginBottom": "40px"
      }
    }
  ],
  "capabilities": [
    {
      "capability": "platform/persistence",
      "config": {
        "dataSources": [
          {
            "id": "speakers",
            "kind": "entity",
            "entityType": "Speaker",
            "query": {
              "sort": [
                {
                  "field": "rank",
                  "direction": "asc"
                }
              ]
            }
          },
          {
            "id": "talks",
            "kind": "entity",
            "entityType": "Talk",
            "query": {
              "sort": [
                {
                  "field": "rank",
                  "direction": "asc"
                }
              ]
            }
          }
        ]
      }
    }
  ],
  "knowledge": {
    "purpose": "Who is speaking and about what, from the speaker and talk records.",
    "laws": [
      "Each speaker names the talk the programme gives them"
    ],
    "patternsExercised": [
      "page-header",
      "card-grid"
    ]
  }
}
