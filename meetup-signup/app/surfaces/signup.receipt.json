{
  "schemaVersion": "1.0.0",
  "id": "signup",
  "version": "1.0.0",
  "kind": "surface",
  "title": "{{t('signup.title')}}",
  "description": "{{t('signup.description')}}",
  "path": {
    "tr": "kayit"
  },
  "blocks": [
    {
      "id": "head",
      "type": "section",
      "props": {
        "paddingY": 32,
        "gap": 8,
        "textAlign": "left"
      },
      "children": [
        {
          "id": "head-t",
          "type": "heading",
          "props": {
            "text": "{{t('signup.heading')}}",
            "level": "h1"
          }
        },
        {
          "id": "head-when",
          "type": "text",
          "props": {
            "content": "{{meetup.0.name}} · {{date(meetup.0.day, 'full')}} · {{t('meetup.doors', meetup.0)}}",
            "fontWeight": "semibold"
          }
        },
        {
          "id": "head-left",
          "type": "container",
          "props": {
            "direction": "column",
            "gap": 0,
            "padding": 0
          },
          "children": [
            {
              "id": "head-left-some",
              "type": "text",
              "props": {
                "content": "{{t('places.left', state)}}",
                "fontWeight": "semibold",
                "color": "var(--pw-color-primary)"
              },
              "visibleWhen": "{{state.left > 0}}"
            },
            {
              "id": "head-left-none",
              "type": "text",
              "props": {
                "content": "{{t('places.left', state)}}",
                "fontWeight": "semibold",
                "color": "var(--pw-color-error)"
              },
              "visibleWhen": "{{state.left == 0}}"
            }
          ],
          "visibleWhen": "{{isNumber(state.left) && !state.sent}}"
        }
      ],
      "style": {
        "paddingBottom": "8px"
      }
    },
    {
      "id": "su",
      "type": "container",
      "props": {
        "direction": "row",
        "gap": 32,
        "padding": 0,
        "wrap": true,
        "align": "start"
      },
      "children": [
        {
          "id": "su-main",
          "type": "container",
          "props": {
            "direction": "column",
            "gap": 16,
            "padding": 0
          },
          "children": [
            {
              "id": "su-form",
              "type": "form",
              "props": {
                "submitLabel": "{{t('signup.submit')}}",
                "submittingWhen": "{{state.sending}}",
                "resetWhen": "{{state.sent}}",
                "gap": 16
              },
              "children": [
                {
                  "id": "su-name",
                  "type": "input",
                  "props": {
                    "name": "name",
                    "label": "{{t('signup.name')}}",
                    "autocomplete": "name",
                    "required": true,
                    "maxLength": 120
                  }
                },
                {
                  "id": "su-email",
                  "type": "input",
                  "props": {
                    "name": "email",
                    "type": "email",
                    "label": "{{t('signup.email')}}",
                    "autocomplete": "email",
                    "required": true,
                    "maxLength": 200
                  }
                },
                {
                  "id": "su-diet",
                  "type": "radio",
                  "props": {
                    "name": "diet",
                    "label": "{{t('signup.diet')}}",
                    "options": [
                      {
                        "label": "{{t('diet.none')}}",
                        "value": "none"
                      },
                      {
                        "label": "{{t('diet.vegetarian')}}",
                        "value": "vegetarian"
                      },
                      {
                        "label": "{{t('diet.vegan')}}",
                        "value": "vegan"
                      },
                      {
                        "label": "{{t('diet.glutenFree')}}",
                        "value": "glutenFree"
                      }
                    ],
                    "defaultValue": "none",
                    "required": true
                  }
                },
                {
                  "id": "su-consent",
                  "type": "checkbox",
                  "props": {
                    "name": "consent",
                    "label": "{{t('signup.consent')}}",
                    "required": true
                  }
                }
              ],
              "visibleWhen": "{{state.left != 0 && !state.sent}}"
            },
            {
              "id": "su-ok",
              "type": "alert",
              "props": {
                "variant": "success",
                "title": "{{t('signup.ok.title')}}",
                "message": "{{t('signup.ok.body')}}",
                "focusOnShow": true
              },
              "visibleWhen": "{{state.sent}}"
            },
            {
              "id": "su-another",
              "type": "button",
              "props": {
                "label": "{{t('signup.another')}}",
                "variant": "outline",
                "action": [
                  {
                    "type": "setState",
                    "key": "sent",
                    "value": false
                  },
                  {
                    "type": "refreshAll"
                  }
                ]
              },
              "visibleWhen": "{{state.sent}}",
              "style": {
                "alignSelf": "flex-start"
              }
            },
            {
              "id": "su-fail",
              "type": "alert",
              "props": {
                "variant": "error",
                "title": "{{t('signup.fail.title')}}",
                "message": "{{state.reason == 'conflict' ? t('signup.fail.conflict') : (state.reason == 'validation' ? t('signup.fail.validation') : (state.reason == 'network' ? t('signup.fail.network') : t('signup.fail.other')))}}",
                "focusOnShow": true
              },
              "visibleWhen": "{{state.failed}}"
            },
            {
              "id": "su-full",
              "type": "container",
              "props": {
                "direction": "column",
                "gap": 8,
                "padding": 0
              },
              "children": [
                {
                  "id": "su-full-t",
                  "type": "heading",
                  "props": {
                    "text": "{{t('signup.full.title')}}",
                    "level": "h2"
                  }
                },
                {
                  "id": "su-full-s",
                  "type": "text",
                  "props": {
                    "content": "{{t('signup.full.body')}}",
                    "color": "var(--pw-color-text-muted)"
                  }
                }
              ],
              "visibleWhen": "{{state.left == 0 && !state.sent}}"
            }
          ],
          "style": {
            "flex": "2 1 340px",
            "minWidth": "0"
          }
        },
        {
          "id": "su-side",
          "type": "card",
          "props": {
            "padding": 20,
            "gap": 8,
            "align": "stretch"
          },
          "children": [
            {
              "id": "side-t",
              "type": "heading",
              "props": {
                "text": "{{t('signup.side.title')}}",
                "level": "h3"
              }
            },
            {
              "id": "side-1",
              "type": "text",
              "props": {
                "content": "{{t('signup.side.free')}}",
                "color": "var(--pw-color-text-muted)"
              }
            },
            {
              "id": "side-2",
              "type": "text",
              "props": {
                "content": "{{t('signup.side.one')}}",
                "color": "var(--pw-color-text-muted)"
              }
            },
            {
              "id": "side-3",
              "type": "text",
              "props": {
                "content": "{{t('signup.side.where')}}",
                "color": "var(--pw-color-text-muted)"
              }
            }
          ],
          "style": {
            "flex": "1 1 240px",
            "minWidth": "0",
            "alignSelf": "flex-start"
          }
        }
      ],
      "style": {
        "paddingBottom": "40px"
      }
    }
  ],
  "capabilities": [
    {
      "capability": "platform/persistence",
      "config": {
        "dataSources": [
          {
            "id": "meetup",
            "kind": "entity",
            "entityType": "Meetup"
          },
          {
            "id": "taken",
            "kind": "entity",
            "entityType": "Signup",
            "aggregate": {
              "fn": "count"
            }
          },
          {
            "id": "signups",
            "kind": "entity",
            "entityType": "Signup",
            "fields": {
              "name": "text",
              "email": "email",
              "diet": "enum",
              "consent": "boolean"
            }
          }
        ],
        "initialState": {
          "left": "{{max(0, meetup.0.capacity - taken.value)}}",
          "sending": false,
          "sent": false,
          "failed": false,
          "reason": ""
        }
      }
    },
    {
      "capability": "platform/entities",
      "config": {
        "formBindings": [
          {
            "formId": "su-form",
            "sourceId": "signups",
            "method": "POST",
            "statusKeys": {
              "loading": "sending",
              "success": "sent",
              "error": "failed",
              "reason": "reason"
            }
          }
        ]
      }
    }
  ],
  "knowledge": {
    "purpose": "The one thing a visitor does here: save a place, while there is one.",
    "laws": [
      "The form writes one Signup record; the server stamps when, and refuses a second sign-up with the same e-mail (unique key)",
      "Places left = the meetup’s capacity minus the count of sign-ups, read when the page opens; at none, the form gives way to a full notice",
      "The capacity is kept by the page, not by the server: the format has no rule for a largest number of records",
      "Visitors may create sign-ups and count them, never read them"
    ],
    "patternsExercised": [
      "page-header",
      "form-with-aside"
    ]
  }
}
