{
  "schemaVersion": "1.0.0",
  "id": "sign-in",
  "version": "1.0.0",
  "kind": "surface",
  "title": "{{t('signIn.title')}}",
  "description": "{{t('signIn.description')}}",
  "blocks": [
    {
      "id": "in",
      "type": "container",
      "props": {
        "direction": "column",
        "gap": 16,
        "padding": 0
      },
      "children": [
        {
          "id": "in-head",
          "type": "section",
          "props": {
            "paddingY": 32,
            "gap": 8,
            "textAlign": "left"
          },
          "children": [
            {
              "id": "in-head-t",
              "type": "heading",
              "props": {
                "text": "{{t('signIn.title')}}",
                "level": "h1"
              }
            },
            {
              "id": "in-head-s",
              "type": "text",
              "props": {
                "content": "{{t('signIn.lead')}}",
                "color": "var(--pw-color-text-muted)"
              }
            }
          ],
          "style": {
            "paddingBottom": "0"
          }
        },
        {
          "id": "in-form",
          "type": "form",
          "props": {
            "submitLabel": "{{t('signIn.submit')}}",
            "onSubmitAction": {
              "type": "auth:signIn"
            },
            "gap": 14
          },
          "children": [
            {
              "id": "in-email",
              "type": "input",
              "props": {
                "name": "email",
                "type": "email",
                "label": "{{t('signup.email')}}",
                "autocomplete": "username",
                "required": true
              }
            },
            {
              "id": "in-password",
              "type": "input",
              "props": {
                "name": "password",
                "type": "password",
                "label": "{{t('signIn.password')}}",
                "autocomplete": "current-password",
                "required": true
              }
            }
          ],
          "style": {
            "maxWidth": "420px"
          }
        },
        {
          "id": "in-refused",
          "type": "alert",
          "props": {
            "variant": "error",
            "title": "{{t('signIn.refused.title')}}",
            "message": "{{t('signIn.refused.body')}}"
          },
          "visibleWhen": "{{!!__auth.error}}",
          "style": {
            "maxWidth": "420px"
          }
        },
        {
          "id": "in-back",
          "type": "link",
          "props": {
            "href": "/signup",
            "text": "{{t('signIn.back')}}",
            "underline": "always"
          }
        }
      ],
      "style": {
        "paddingBottom": "40px"
      }
    }
  ],
  "knowledge": {
    "purpose": "The app’s own sign-in screen: e-mail and password, a refusal in the app’s words, and the way back for a visitor who came here by mistake."
  }
}
