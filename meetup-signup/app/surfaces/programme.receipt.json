{
  "schemaVersion": "1.0.0",
  "id": "programme",
  "version": "1.0.0",
  "kind": "surface",
  "title": "{{t('programme.title')}}",
  "titleTemplate": false,
  "description": "{{t('programme.description')}}",
  "blocks": [
    {
      "id": "hero",
      "type": "container",
      "props": {
        "direction": "row",
        "gap": 32,
        "padding": 0,
        "wrap": true,
        "align": "center"
      },
      "children": [
        {
          "id": "hero-copy",
          "type": "container",
          "props": {
            "direction": "column",
            "gap": 14,
            "padding": 0
          },
          "children": [
            {
              "id": "hero-kicker",
              "type": "text",
              "props": {
                "content": "{{t('hero.kicker')}}",
                "color": "var(--pw-color-primary)",
                "fontWeight": "bold"
              }
            },
            {
              "id": "hero-t",
              "type": "heading",
              "props": {
                "text": "{{meetup.0.name}}",
                "level": "h1"
              }
            },
            {
              "id": "hero-when",
              "type": "text",
              "props": {
                "content": "{{date(meetup.0.day, 'full')}} · {{t('meetup.doors', meetup.0)}}",
                "fontWeight": "semibold"
              }
            },
            {
              "id": "hero-s",
              "type": "text",
              "props": {
                "content": "{{t('hero.lead')}}",
                "color": "var(--pw-color-text-muted)"
              }
            },
            {
              "id": "hero-left",
              "type": "container",
              "props": {
                "direction": "column",
                "gap": 0,
                "padding": 0
              },
              "children": [
                {
                  "id": "hero-left-some",
                  "type": "text",
                  "props": {
                    "content": "{{t('places.left', state)}}",
                    "fontWeight": "semibold",
                    "color": "var(--pw-color-primary)"
                  },
                  "visibleWhen": "{{state.left > 0}}"
                },
                {
                  "id": "hero-left-none",
                  "type": "text",
                  "props": {
                    "content": "{{t('places.left', state)}}",
                    "fontWeight": "semibold",
                    "color": "var(--pw-color-error)"
                  },
                  "visibleWhen": "{{state.left == 0}}"
                }
              ],
              "visibleWhen": "{{isNumber(state.left)}}"
            },
            {
              "id": "hero-cta",
              "type": "container",
              "props": {
                "direction": "row",
                "gap": 12,
                "padding": 0,
                "wrap": true,
                "align": "center"
              },
              "children": [
                {
                  "id": "hero-signup",
                  "type": "button",
                  "props": {
                    "label": "{{t('cta.signup')}}",
                    "href": "/signup",
                    "variant": "primary",
                    "size": "large",
                    "icon": "calendar"
                  },
                  "visibleWhen": "{{state.left != 0}}"
                },
                {
                  "id": "hero-speakers",
                  "type": "button",
                  "props": {
                    "label": "{{t('cta.speakers')}}",
                    "href": "/speakers",
                    "variant": "outline",
                    "size": "large"
                  }
                }
              ]
            }
          ],
          "style": {
            "flex": "1 1 340px",
            "minWidth": "0"
          }
        },
        {
          "id": "hero-pic",
          "type": "image",
          "props": {
            "src": "pwpack/media/stage.svg",
            "alt": "{{t('hero.alt')}}",
            "width": 720,
            "height": 360,
            "aspectRatio": "2/1",
            "objectFit": "cover",
            "borderRadius": "var(--pw-border-radius-lg)",
            "priority": true
          },
          "style": {
            "flex": "1 1 360px",
            "maxWidth": "100%",
            "height": "auto"
          }
        }
      ],
      "style": {
        "paddingTop": "32px",
        "paddingBottom": "24px"
      }
    },
    {
      "id": "prog",
      "type": "container",
      "props": {
        "direction": "column",
        "gap": 12,
        "padding": 0
      },
      "children": [
        {
          "id": "prog-t",
          "type": "heading",
          "props": {
            "text": "{{t('programme.heading')}}",
            "level": "h2"
          }
        },
        {
          "id": "prog-err",
          "type": "alert",
          "props": {
            "variant": "error",
            "title": "{{t('programme.err.title')}}",
            "message": "{{t('err.retryText')}}"
          },
          "visibleWhen": "{{!!__errors.talks}}"
        },
        {
          "id": "prog-retry",
          "type": "button",
          "props": {
            "label": "{{t('ui.retry')}}",
            "variant": "outline",
            "icon": "refresh-cw",
            "action": {
              "type": "refresh",
              "sourceId": "talks"
            }
          },
          "visibleWhen": "{{!!__errors.talks}}",
          "style": {
            "alignSelf": "flex-start"
          }
        },
        {
          "id": "prog-wait",
          "type": "container",
          "props": {
            "direction": "column",
            "gap": 10,
            "padding": 0
          },
          "children": [
            {
              "id": "prog-wait-1",
              "type": "skeleton",
              "props": {
                "variant": "rectangle",
                "height": 84,
                "width": "100%"
              }
            },
            {
              "id": "prog-wait-2",
              "type": "skeleton",
              "props": {
                "variant": "rectangle",
                "height": 84,
                "width": "100%"
              }
            },
            {
              "id": "prog-wait-3",
              "type": "skeleton",
              "props": {
                "variant": "rectangle",
                "height": 84,
                "width": "100%"
              }
            },
            {
              "id": "prog-wait-4",
              "type": "skeleton",
              "props": {
                "variant": "rectangle",
                "height": 84,
                "width": "100%"
              }
            }
          ],
          "visibleWhen": "{{__loading.talks && length(talks) == 0}}"
        },
        {
          "id": "prog-list",
          "type": "container",
          "props": {
            "direction": "column",
            "gap": 10,
            "padding": 0
          },
          "children": [
            {
              "id": "slot",
              "type": "card",
              "props": {
                "padding": 18,
                "gap": 0,
                "align": "stretch"
              },
              "children": [
                {
                  "id": "slot-row",
                  "type": "container",
                  "props": {
                    "direction": "row",
                    "gap": 18,
                    "padding": 0,
                    "wrap": false,
                    "align": "start",
                    "keepRow": true
                  },
                  "children": [
                    {
                      "id": "slot-time",
                      "type": "text",
                      "props": {
                        "content": "{{item.time}}",
                        "fontWeight": "bold",
                        "color": "var(--pw-color-primary)"
                      },
                      "style": {
                        "flex": "0 0 3.5rem",
                        "fontVariantNumeric": "tabular-nums",
                        "fontSize": "var(--pw-font-size-lg)"
                      }
                    },
                    {
                      "id": "slot-body",
                      "type": "container",
                      "props": {
                        "direction": "column",
                        "gap": 4,
                        "padding": 0
                      },
                      "children": [
                        {
                          "id": "slot-title",
                          "type": "heading",
                          "props": {
                            "text": "{{t('talk.title', item)}}",
                            "level": "h3"
                          }
                        },
                        {
                          "id": "slot-who",
                          "type": "text",
                          "props": {
                            "content": "{{t('talk.by', find(speakers, 'id', item.speaker))}}",
                            "fontWeight": "semibold"
                          },
                          "visibleWhen": "{{item.kind == 'talk'}}"
                        },
                        {
                          "id": "slot-sum",
                          "type": "text",
                          "props": {
                            "content": "{{t('talk.summary', item)}}",
                            "color": "var(--pw-color-text-muted)"
                          }
                        }
                      ],
                      "style": {
                        "flex": "1 1 0",
                        "minWidth": "0"
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "repeat": "{{talks}}",
          "visibleWhen": "{{length(talks) > 0}}"
        }
      ],
      "style": {
        "paddingBottom": "32px"
      }
    },
    {
      "id": "where",
      "type": "card",
      "props": {
        "padding": 24,
        "gap": 8,
        "align": "start"
      },
      "children": [
        {
          "id": "where-t",
          "type": "heading",
          "props": {
            "text": "{{t('where.heading')}}",
            "level": "h2"
          }
        },
        {
          "id": "where-v",
          "type": "text",
          "props": {
            "content": "{{meetup.0.venue}}, {{meetup.0.address}}",
            "fontWeight": "semibold"
          }
        },
        {
          "id": "where-s",
          "type": "text",
          "props": {
            "content": "{{t('where.access')}}",
            "color": "var(--pw-color-text-muted)"
          }
        }
      ],
      "style": {
        "marginBottom": "40px"
      }
    }
  ],
  "capabilities": [
    {
      "capability": "platform/persistence",
      "config": {
        "dataSources": [
          {
            "id": "meetup",
            "kind": "entity",
            "entityType": "Meetup"
          },
          {
            "id": "taken",
            "kind": "entity",
            "entityType": "Signup",
            "aggregate": {
              "fn": "count"
            }
          },
          {
            "id": "talks",
            "kind": "entity",
            "entityType": "Talk",
            "query": {
              "sort": [
                {
                  "field": "rank",
                  "direction": "asc"
                }
              ]
            }
          },
          {
            "id": "speakers",
            "kind": "entity",
            "entityType": "Speaker",
            "query": {
              "sort": [
                {
                  "field": "rank",
                  "direction": "asc"
                }
              ]
            }
          }
        ],
        "initialState": {
          "left": "{{max(0, meetup.0.capacity - taken.value)}}"
        }
      }
    }
  ],
  "knowledge": {
    "purpose": "The evening at a glance: when and where, how many places are left, and the programme from the meetup’s records.",
    "laws": [
      "The places line is one plural message per language, filled from the capacity and the count of sign-ups",
      "The sign-up button disappears when no place is left",
      "A talk names its speaker; a break does not"
    ],
    "patternsExercised": [
      "hero-split",
      "timeline"
    ]
  }
}
