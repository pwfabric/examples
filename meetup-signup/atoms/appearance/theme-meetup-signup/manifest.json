    "spacing": {
      "base": "1rem",
      "xs": "0.25rem",
      "sm": "0.5rem",
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2rem",
      "xxl": "3rem"
    },
    "shadows": {
      "card": "0 1px 3px 0 rgba(29,24,56,.08)",
      "button": "none",
