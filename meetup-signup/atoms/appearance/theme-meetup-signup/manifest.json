{
  "id": "theme-meetup-signup",
  "kind": "ui-appearance",
  "version": "1.0.0",
  "category": "ui",
  "name": "Example Meetup",
  "state": "stable",
  "description": "Night indigo and coral: a community meetup's own look, bold grotesque headings over a plain sans, generous corners.",
