{
  "schemaVersion": "1.0.0",
  "id": "plans",
  "version": "1.0.0",
  "kind": "surface",
  "appearance": {
    "use": "theme-lighting-hub-waitlist"
  },
  "title": "Kits",
  "description": "Example Light kits, paid once: Studio, Home and House. What beta households say, the questions people ask, the waitlist and the demo flat.",
  "category": "content",
  "tags": [
    "lighting",
    "home",
    "plans"
  ],
  "blocks": [
    {
      "id": "intro",
      "type": "section",
      "props": {
        "paddingY": 40,
        "gap": 12
      },
      "children": [
        {
          "id": "intro-h",
          "type": "heading",
          "props": {
            "text": "Kits",
            "level": "h1"
          }
        },
        {
          "id": "intro-t",
          "type": "text",
          "props": {
            "content": "One hub in every kit, paid once. Pick how many lights come with it, then join the waitlist: no payment until your kit ships.",
            "color": "var(--pw-color-text-muted)"
          },
          "style": {
            "fontSize": "var(--pw-font-size-lg)",
            "maxWidth": "65ch",
            "margin": "0",
            "alignSelf": "flex-start"
          }
        }
      ]
    },
    {
      "id": "kits",
      "type": "section",
      "props": {
        "paddingY": 64,
        "gap": 32
      },
      "children": [
        {
          "id": "kits-head",
          "type": "container",
          "props": {
            "direction": "column",
            "gap": 8
          },
          "children": [
            {
              "id": "kits-h",
              "type": "heading",
              "props": {
                "text": "Three kits",
                "level": "h2"
              }
            },
            {
              "id": "kits-sub",
              "type": "text",
              "props": {
                "content": "One hub in every kit and no subscription: everything runs on the hub you own.",
                "color": "var(--pw-color-text-muted)"
              },
              "style": {
                "maxWidth": "65ch",
                "margin": "0",
                "alignSelf": "flex-start"
              }
            }
          ]
        },
        {
          "id": "kits-grid",
          "type": "grid",
          "props": {
            "columns": 3,
            "gap": 24,
            "alignItems": "stretch"
          },
          "children": [
            {
              "id": "kits-p1",
              "type": "card",
              "props": {
                "padding": 20,
                "gap": 12,
                "shadow": "sm"
              },
              "children": [
                {
                  "id": "kits-p1-plan",
                  "type": "heading",
                  "props": {
                    "text": "Studio",
                    "level": "h3"
                  }
                },
                {
                  "id": "kits-p1-price",
                  "type": "money",
                  "props": {
                    "amount": 249,
                    "currency": "EUR",
                    "period": "",
                    "size": "xl",
                    "emphasis": "strong",
                    "whole": true
                  }
                },
                {
                  "id": "kits-p1-features",
                  "type": "list",
                  "props": {
                    "items": [
                      "Hub and 4 colour bulbs",
                      "Up to 2 rooms",
                      "You set it up in about 20 minutes"
                    ],
                    "style": "check"
                  }
                },
                {
                  "id": "kits-p1-cta",
                  "type": "button",
                  "props": {
                    "label": "Choose Studio",
                    "href": "/plans?choice=studio#waitlist",
                    "variant": "outline"
                  }
                }
              ],
              "layout": {
                "order": {
                  "xs": 1,
                  "sm": 0
                }
              }
            },
            {
              "id": "kits-p2",
              "type": "card",
              "props": {
                "padding": 20,
                "gap": 12,
                "shadow": "sm",
                "borderWidth": 2,
                "borderColor": "var(--pw-color-primary)"
              },
              "children": [
                {
                  "id": "kits-p2-plan",
                  "type": "heading",
                  "props": {
                    "text": "Home",
                    "level": "h3"
                  }
                },
                {
                  "id": "kits-p2-price",
                  "type": "money",
                  "props": {
                    "amount": 549,
                    "currency": "EUR",
                    "period": "",
                    "size": "xl",
                    "emphasis": "strong",
                    "whole": true
                  }
                },
                {
                  "id": "kits-p2-features",
                  "type": "list",
                  "props": {
                    "items": [
                      "Hub, 8 bulbs, 2 strips, 2 dimmers",
                      "Up to 6 rooms",
                      "You set it up in under an hour"
                    ],
                    "style": "check"
                  }
                },
                {
                  "id": "kits-p2-cta",
                  "type": "button",
                  "props": {
                    "label": "Choose Home",
                    "href": "/plans?choice=home#waitlist",
                    "variant": "primary"
                  }
                }
              ]
            },
            {
              "id": "kits-p3",
              "type": "card",
              "props": {
                "padding": 20,
                "gap": 12,
                "shadow": "sm"
              },
              "children": [
                {
                  "id": "kits-p3-plan",
                  "type": "heading",
                  "props": {
                    "text": "House",
                    "level": "h3"
                  }
                },
                {
                  "id": "kits-p3-price",
                  "type": "money",
                  "props": {
                    "amount": 1090,
                    "currency": "EUR",
                    "period": "",
                    "size": "xl",
                    "emphasis": "strong",
                    "whole": true
                  }
                },
                {
                  "id": "kits-p3-features",
                  "type": "list",
                  "props": {
                    "items": [
                      "Hub, 16 bulbs, 4 strips, 4 dimmers",
                      "Any number of rooms",
                      "Our team sets it up in your home"
                    ],
                    "style": "check"
                  }
                },
                {
                  "id": "kits-p3-cta",
                  "type": "button",
                  "props": {
                    "label": "Choose House",
                    "href": "/plans?choice=house#waitlist",
                    "variant": "outline"
                  }
                }
              ],
              "layout": {
                "order": {
                  "xs": 1,
                  "sm": 0
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "voices",
      "type": "section",
      "props": {
        "paddingY": 64,
        "gap": 32
      },
      "children": [
        {
          "id": "voices-head",
          "type": "container",
          "props": {
            "direction": "column",
            "gap": 8
          },
          "children": [
            {
              "id": "voices-h",
              "type": "heading",
              "props": {
                "text": "From the private beta",
                "level": "h2"
              }
            }
          ]
        },
        {
          "id": "voices-grid",
          "type": "grid",
          "props": {
            "columns": 2,
            "columnsXs": 1,
            "gap": 24,
            "alignItems": "stretch"
          },
          "children": [
            {
              "id": "voices-t",
              "type": "card",
              "props": {
                "padding": 20,
                "gap": 12,
                "shadow": "sm"
              },
              "children": [
                {
                  "id": "voices-t-q",
                  "type": "text",
                  "props": {
                    "content": "“{{item.quote}}”"
                  },
                  "style": {
                    "fontSize": "var(--pw-font-size-lg)"
                  }
                },
                {
                  "id": "voices-t-p",
                  "type": "container",
                  "props": {
                    "direction": "row",
                    "keepRow": true,
                    "gap": 12,
                    "align": "center"
                  },
                  "children": [
                    {
                      "id": "voices-t-a",
                      "type": "avatar",
                      "props": {
                        "name": "{{item.author}}",
                        "size": "md"
                      },
                      "style": {
                        "flex": "0 0 auto"
                      }
                    },
                    {
                      "id": "voices-t-m",
                      "type": "container",
                      "props": {
                        "direction": "column",
                        "gap": 2
                      },
                      "style": {
                        "flex": "1 1 0",
                        "minWidth": "0"
                      },
                      "children": [
                        {
                          "id": "voices-t-n",
                          "type": "text",
                          "props": {
                            "content": "{{item.author}}",
                            "fontWeight": "semibold"
                          }
                        },
                        {
                          "id": "voices-t-tt",
                          "type": "text",
                          "props": {
                            "content": "{{item.role}}",
                            "color": "var(--pw-color-text-muted)"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "repeat": "{{state.testimonialItems}}"
        }
      ],
      "visibleWhen": "{{state.testimonialItems.length > 0}}"
    },
    {
      "id": "faq",
      "type": "section",
      "props": {
        "paddingY": 48,
        "gap": 16
      },
      "children": [
        {
          "id": "faq-h",
          "type": "heading",
          "props": {
            "text": "Questions people ask",
            "level": "h2"
          }
        },
        {
          "id": "faq-acc",
          "type": "accordion",
          "props": {
            "items": [
              {
                "id": "lamps",
                "title": "Do I need new lamps?",
                "content": "No. The hub drives the bulbs and strips in the kit and any smart bulb on your home network from the makers on the home page. Your shades and fittings stay."
              },
              {
                "id": "fee",
                "title": "Is there a monthly fee?",
                "content": "No. You pay once for the kit. Firmware updates are free."
              },
              {
                "id": "offline",
                "title": "What happens when the internet is down?",
                "content": "Nothing changes. The hub keeps the scenes, the sun times and your habits itself; it only goes online to fetch updates."
              },
              {
                "id": "switches",
                "title": "Can I still use the wall switches?",
                "content": "Yes. A switch always wins over the hub, and the hub remembers that you wanted it that way."
              },
              {
                "id": "when",
                "title": "When do kits ship, and when do I pay?",
                "content": "The first kits ship in March 2027, in the order people joined the waitlist. We ask for payment only when your kit is ready to ship."
              },
              {
                "id": "see",
                "title": "Can I see it before I buy?",
                "content": "Yes. The demo flat at 12 Example Street is open on Saturdays from 11:00 to 17:00, lit by a House kit. No booking needed."
              }
            ]
          }
        }
      ]
    },
    {
      "id": "waitlist",
      "type": "section",
      "props": {
        "paddingY": 64,
        "gap": 32
      },
      "children": [
        {
          "id": "waitlist-row",
          "type": "container",
          "props": {
            "direction": "row",
            "gap": 48,
            "align": "stretch",
            "padding": 0
          },
          "children": [
            {
              "id": "waitlist-copy",
              "type": "container",
              "props": {
                "direction": "column",
                "gap": 12,
                "padding": 0
              },
              "children": [
                {
                  "id": "waitlist-h",
                  "type": "heading",
                  "props": {
                    "text": "Join the waitlist",
                    "level": "h2"
                  }
                },
                {
                  "id": "waitlist-t",
                  "type": "text",
                  "props": {
                    "content": "Tell us which kit you have in mind and we will write when it is ready to ship. The first kits ship in March 2027, in the order people joined; no payment until then.",
                    "color": "var(--pw-color-text-muted)"
                  }
                }
              ],
              "style": {
                "flex": "1 1 0",
                "minWidth": "0",
                "maxWidth": "420px"
              }
            },
            {
              "id": "waitlist-side",
              "type": "container",
              "props": {
                "direction": "column",
                "gap": 12,
                "align": "stretch",
                "padding": 0
              },
              "children": [
                {
                  "id": "waitlist-form",
                  "type": "form",
                  "props": {
                    "submitLabel": "Join the waitlist",
                    "gap": 12,
                    "submittingWhen": "{{state.contactSending}}",
                    "resetWhen": "{{state.contactSent}}"
                  },
                  "children": [
                    {
                      "id": "waitlist-name",
                      "type": "input",
                      "props": {
                        "name": "name",
                        "label": "Name",
                        "required": true,
                        "type": "text"
                      }
                    },
                    {
                      "id": "waitlist-email",
                      "type": "input",
                      "props": {
                        "name": "email",
                        "type": "email",
                        "label": "Email",
                        "required": true
                      }
                    },
                    {
                      "id": "waitlist-choice",
                      "type": "select",
                      "props": {
                        "name": "kit",
                        "label": "Which kit?",
                        "placeholder": "Choose a kit",
                        "options": [
                          {
                            "label": "Studio — €249",
                            "value": "studio"
                          },
                          {
                            "label": "Home — €549",
                            "value": "home"
                          },
                          {
                            "label": "House — €1,090",
                            "value": "house"
                          }
                        ],
                        "required": true,
                        "defaultValue": "{{state.choice}}",
                        "stateKey": "choice"
                      }
                    },
                    {
                      "id": "waitlist-msg",
                      "type": "textarea",
                      "props": {
                        "name": "message",
                        "label": "Which rooms would you light first? (optional)",
                        "rows": 4
                      }
                    }
                  ]
                },
                {
                  "id": "waitlist-ok",
                  "type": "alert",
                  "visibleWhen": "{{state.contactSent}}",
                  "props": {
                    "message": "You are on the waitlist. We will write to you when your kit is ready to ship; no payment until then.",
                    "variant": "success",
                    "focusOnShow": true
                  }
                },
                {
                  "id": "waitlist-another",
                  "type": "button",
                  "visibleWhen": "{{state.contactSent && state.contactCopy.another != ''}}",
                  "props": {
                    "label": "{{state.contactCopy.another}}",
                    "variant": "outline",
                    "action": [
                      {
                        "type": "setState",
                        "key": "contactSent",
                        "value": false
                      },
                      {
                        "type": "setState",
                        "key": "choice",
                        "value": ""
                      }
                    ]
                  },
                  "style": {
                    "alignSelf": "flex-start"
                  }
                },
                {
                  "id": "waitlist-err",
                  "type": "alert",
                  "visibleWhen": "{{state.contactFailed}}",
                  "props": {
                    "title": "{{state.contactCopy[state.contactReason] || state.contactCopy.error}}",
                    "variant": "error",
                    "focusOnShow": true
                  }
                }
              ],
              "style": {
                "flex": "1 1 0",
                "minWidth": "0"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "flat",
      "type": "section",
      "props": {
        "paddingY": 48,
        "gap": 16
      },
      "children": [
        {
          "id": "flat-h",
          "type": "heading",
          "props": {
            "text": "See it lit in the demo flat",
            "level": "h2"
          }
        },
        {
          "id": "flat-t",
          "type": "text",
          "props": {
            "content": "12 Example Street, ground floor, ring “Example Light”. Open Saturdays 11:00 to 17:00, no booking needed; the bus stop on Example Street, at the corner of Example Road, is two minutes away.",
            "color": "var(--pw-color-text-muted)"
          },
          "style": {
            "maxWidth": "65ch",
            "margin": "0",
            "alignSelf": "flex-start"
          }
        },
        {
          "id": "flat-map",
          "type": "image",
          "props": {
            "src": "pwpack/media/demo-flat-sketch-map.svg",
            "alt": "Sketch map: the demo flat at 12 Example Street marked in amber, a short walk from the bus stop, Example Park across the road",
            "aspectRatio": "12/7",
            "borderRadius": "var(--pw-border-radius-lg)"
          },
          "style": {
            "width": "100%",
            "maxWidth": "880px",
            "alignSelf": "flex-start",
            "margin": "0"
          }
        }
      ]
    }
  ],
  "capabilities": [
    {
      "capability": "platform/persistence",
      "required": false,
      "config": {
        "dataSources": [
          {
            "id": "contactMessages",
            "kind": "entity",
            "entityType": "WaitlistEntry",
            "fallback": []
          }
        ],
        "initialState": {
          "here": "plans",
          "testimonialItems": [
            {
              "quote": "I stopped touching the switches in the second week. The kitchen is just right at seven, and the living room goes amber when the film starts.",
              "author": "Jane Doe",
              "role": "Beta household, two-room flat"
            },
            {
              "quote": "Our internet was down for a whole weekend. Nobody in the house noticed: the lights did exactly what they always do.",
              "author": "Sam Doe",
              "role": "Beta household, family of four"
            }
          ],
          "contactSending": false,
          "contactSent": false,
          "contactFailed": false,
          "contactReason": "",
          "contactFields": [],
          "contactCopy": {
            "error": "Your entry did not arrive. Try again in a moment.",
            "validation": "Your entry did not arrive. Check the fields above, then join again.",
            "unauthenticated": "",
            "forbidden": "",
            "conflict": "That e-mail is already on the waitlist. We will write to it when your kit is ready to ship.",
            "network": "Your entry did not arrive. Check your connection, then join again.",
            "server": "",
            "another": "Add another person"
          },
          "choice": ""
        },
        "behaviors": [
          {
            "id": "waitlist-name-edit",
            "event": "input:change",
            "targetBlockId": "waitlist-name",
            "actions": [
              {
                "type": "setState",
                "key": "contactSent",
                "value": false
              },
              {
                "type": "setState",
                "key": "contactFailed",
                "value": false
              }
            ]
          },
          {
            "id": "waitlist-email-edit",
            "event": "input:change",
            "targetBlockId": "waitlist-email",
            "actions": [
              {
                "type": "setState",
                "key": "contactSent",
                "value": false
              },
              {
                "type": "setState",
                "key": "contactFailed",
                "value": false
              }
            ]
          },
          {
            "id": "waitlist-msg-edit",
            "event": "input:change",
            "targetBlockId": "waitlist-msg",
            "actions": [
              {
                "type": "setState",
                "key": "contactSent",
                "value": false
              },
              {
                "type": "setState",
                "key": "contactFailed",
                "value": false
              }
            ]
          },
          {
            "id": "waitlist-choice-edit",
            "event": "input:change",
            "targetBlockId": "waitlist-choice",
            "actions": [
              {
                "type": "setState",
                "key": "contactSent",
                "value": false
              },
              {
                "type": "setState",
                "key": "contactFailed",
                "value": false
              }
            ]
          }
        ],
        "urlState": [
          "choice"
        ]
      }
    },
    {
      "capability": "platform/entities",
      "required": false,
      "config": {
        "formBindings": [
          {
            "formId": "waitlist-form",
            "sourceId": "contactMessages",
            "method": "POST",
            "statusKeys": {
              "loading": "contactSending",
              "success": "contactSent",
              "error": "contactFailed",
              "reason": "contactReason",
              "fields": "contactFields"
            }
          }
        ]
      }
    }
  ],
  "knowledge": {
    "purpose": "Choose a kit and join the waitlist: three kits with the same rows, two beta voices, the questions people ask, the waitlist form, and where to see it lit.",
    "laws": [
      "Three kits with the same row topics (in the box, rooms, setup); only the middle one is emphasised",
      "Prices are money blocks in whole euros — the currency is a prop",
      "Each kit button names its kit and carries it to the waitlist form (?choice=), which preselects it; the form writes a WaitlistEntry record and says so",
      "The next edit after a result hides it",
      "The demo flat is a sketch map with its address written out beside it"
    ],
    "patternsExercised": [
      "band-pricing",
      "band-testimonial",
      "faq",
      "contact-form"
    ]
  }
}
