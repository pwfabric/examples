{
  "schemaVersion": "1.0.0",
  "id": "item",
  "version": "1.0.0",
  "kind": "surface",
  "appearance": {
    "use": "theme-equipment-checkout"
  },
  "title": "{{item.0.name}}",
  "description": "{{item.0.name}} ({{item.0.tag}}): {{item.0.description}}",
  "category": "app",
  "tags": [
    "equipment",
    "team",
    "loans"
  ],
  "blocks": [
    {
      "id": "back",
      "type": "button",
      "props": {
        "label": "All equipment",
        "href": "/",
        "variant": "ghost",
        "icon": "arrow-left"
      },
      "style": {
        "alignSelf": "flex-start",
        "marginTop": "16px"
      }
    },
    {
      "id": "wait",
      "type": "container",
      "props": {
        "padding": 0,
        "direction": "column",
        "gap": 12
      },
      "visibleWhen": "{{__loading.item && length(item) == 0}}",
      "children": [
        {
          "id": "wait-s",
          "type": "spinner",
          "props": {
            "size": "sm",
            "label": "Loading…",
            "variant": "muted"
          }
        },
        {
          "id": "wait-k",
          "type": "skeleton",
          "props": {
            "variant": "text",
            "lines": 6
          }
        }
      ]
    },
    {
      "id": "item-err",
      "type": "container",
      "props": {
        "padding": 0,
        "direction": "column",
        "gap": 12,
        "align": "start"
      },
      "visibleWhen": "{{!!__errors.item}}",
      "children": [
        {
          "id": "item-err-a",
          "type": "alert",
          "props": {
            "variant": "error",
            "title": "{{__errors.item == 'forbidden' ? 'Your account is not on the team list' : 'The equipment did not load'}}",
            "message": "{{__errors.item == 'forbidden' ? 'Ask the office manager to add you to the team, then sign in again.' : 'Check your connection and try again.'}}"
          }
        },
        {
          "id": "item-err-b",
          "type": "button",
          "props": {
            "label": "Try again",
            "variant": "outline",
            "icon": "refresh-cw",
            "action": {
              "type": "refresh",
              "sourceId": "item"
            }
          },
          "visibleWhen": "{{__errors.item != 'forbidden'}}"
        }
      ]
    },
    {
      "id": "rec",
      "type": "container",
      "props": {
        "padding": 0,
        "direction": {
          "xs": "column",
          "md": "row"
        },
        "gap": {
          "xs": 20,
          "md": 32
        },
        "align": {
          "xs": "stretch",
          "md": "start"
        }
      },
      "visibleWhen": "{{length(item) > 0}}",
      "style": {
        "marginTop": "8px"
      },
      "children": [
        {
          "id": "pic",
          "type": "image",
          "props": {
            "src": "{{item.0.image}}",
            "alt": "{{item.0.imageAlt}}",
            "aspectRatio": "4/3",
            "objectFit": "cover",
            "width": "100%",
            "borderRadius": "var(--pw-border-radius-lg, 12px)",
            "loading": "eager",
            "priority": true
          },
          "style": {
            "flex": {
              "xs": "1 1 auto",
              "md": "0 0 320px"
            },
            "maxWidth": {
              "xs": "100%",
              "md": "320px"
            }
          }
        },
        {
          "id": "facts",
          "type": "container",
          "props": {
            "padding": 0,
            "direction": "column",
            "gap": 10
          },
          "style": {
            "flex": "1 1 0",
            "minWidth": "0"
          },
          "children": [
            {
              "id": "facts-tag",
              "type": "text",
              "props": {
                "content": "{{item.0.tag}} · {{item.0.kind}}",
                "color": "var(--pw-color-text-muted)"
              },
              "style": {
                "fontVariantNumeric": "tabular-nums"
              }
            },
            {
              "id": "facts-name",
              "type": "heading",
              "props": {
                "text": "{{item.0.name}}",
                "level": "h1"
              }
            },
            {
              "id": "facts-desc",
              "type": "text",
              "props": {
                "content": "{{item.0.description}}"
              }
            },
            {
              "id": "facts-where",
              "type": "text",
              "props": {
                "content": "Kept in: {{item.0.location}}",
                "color": "var(--pw-color-text-muted)"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "borrow",
      "type": "card",
      "visibleWhen": "{{length(item) > 0 && !__loading.openLoan && !__errors.openLoan && length(openLoan) == 0}}",
      "props": {
        "padding": 20,
        "gap": 12,
        "shadow": "none",
        "borderWidth": 1
      },
      "style": {
        "marginTop": "24px"
      },
      "children": [
        {
          "id": "borrow-h",
          "type": "heading",
          "props": {
            "text": "Borrow it",
            "level": "h2"
          },
          "style": {
            "fontSize": "var(--pw-font-size-xl)"
          }
        },
        {
          "id": "borrow-t",
          "type": "text",
          "props": {
            "content": "It is in the cupboard. Say when you will bring it back; the team sees it in History.",
            "color": "var(--pw-color-text-muted)"
          }
        },
        {
          "id": "borrow-form",
          "type": "form",
          "props": {
            "submitLabel": "Borrow it",
            "gap": 12,
            "submittingWhen": "{{state.borrowing}}",
            "resetWhen": "{{state.borrowed}}"
          },
          "children": [
            {
              "id": "b-eq",
              "type": "input",
              "props": {
                "type": "hidden",
                "name": "equipment",
                "value": "{{item.0.id}}"
              }
            },
            {
              "id": "b-due",
              "type": "date-input",
              "props": {
                "name": "dueBack",
                "label": "Back by",
                "required": true,
                "calendar": true,
                "minDate": "{{today()}}",
                "stateKey": "due",
                "value": "{{state.due}}"
              }
            },
            {
              "id": "b-note",
              "type": "textarea",
              "props": {
                "name": "note",
                "label": "What for? (optional)",
                "rows": 2,
                "maxLength": 200,
                "stateKey": "note"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "borrow-ok",
      "type": "alert",
      "visibleWhen": "{{state.borrowed}}",
      "props": {
        "variant": "success",
        "title": "It is yours until {{date(state.due)}}",
        "message": "Take it from {{item.0.location}}. Mark it returned here when you put it back.",
        "focusOnShow": true
      },
      "style": {
        "marginTop": "16px"
      }
    },
    {
      "id": "borrow-fail",
      "type": "alert",
      "visibleWhen": "{{state.borrowFailed || state.markFailed}}",
      "props": {
        "variant": "error",
        "title": "{{state.borrowReason == 'forbidden' ? 'Your account may look but not borrow. Ask the office manager to add you to the team.' : (state.markReason == 'forbidden' || state.markReason == 'error' ? 'Only the person who borrowed it, or the kit keeper, can mark it returned.' : 'That did not go through. Check your connection and try again.')}}",
        "focusOnShow": true
      },
      "style": {
        "marginTop": "16px"
      }
    },
    {
      "id": "out",
      "type": "card",
      "visibleWhen": "{{length(item) > 0 && length(openLoan) > 0}}",
      "props": {
        "padding": 20,
        "gap": 12,
        "shadow": "none",
        "borderWidth": 1
      },
      "style": {
        "marginTop": "24px"
      },
      "children": [
        {
          "id": "out-h",
          "type": "heading",
          "props": {
            "text": "{{openLoan.0.dueBack < today() ? 'Overdue' : 'Out on loan'}}",
            "level": "h2"
          },
          "style": {
            "fontSize": "var(--pw-font-size-xl)"
          }
        },
        {
          "id": "out-t",
          "type": "text",
          "props": {
            "content": "{{openLoan.0.owner == me.id ? 'You have' : openLoan.0.borrower + ' has'}} it{{openLoan.0.dueBack < today() ? ', due back on ' : ', back by '}}{{date(openLoan.0.dueBack, 'full')}}{{openLoan.0.note ? ': ' + openLoan.0.note : '.'}}"
          }
        },
        {
          "id": "out-help",
          "type": "text",
          "props": {
            "content": "{{openLoan.0.owner == me.id || includes(me.roles, 'keeper') ? 'Put it back in ' + item.0.location + ', then mark it returned so the next person can borrow it.' : 'Ask ' + openLoan.0.borrower + ' when it will be back, or the kit keeper if it is needed sooner.'}}",
            "color": "var(--pw-color-text-muted)"
          }
        },
        {
          "id": "out-return",
          "type": "button",
          "props": {
            "label": "Mark as returned",
            "variant": "primary",
            "icon": "check",
            "action": [
              {
                "type": "write",
                "sourceId": "openLoan",
                "op": "update",
                "id": "{{openLoan.0.id}}",
                "values": {
                  "status": "returned",
                  "returnedAt": "{{today()}}"
                },
                "statusKeys": {
                  "loading": "returning",
                  "success": "returned",
                  "error": "markFailed",
                  "reason": "markReason"
                }
              },
              {
                "type": "setState",
                "key": "borrowed",
                "value": false
              }
            ],
            "disabled": "{{state.returning}}"
          },
          "style": {
            "alignSelf": "flex-start"
          },
          "visibleWhen": "{{openLoan.0.owner == me.id || includes(me.roles, 'keeper')}}"
        }
      ]
    },
    {
      "id": "return-ok",
      "type": "alert",
      "visibleWhen": "{{state.returned && length(openLoan) == 0}}",
      "props": {
        "variant": "success",
        "title": "Marked as returned. Thank you.",
        "focusOnShow": true
      },
      "style": {
        "marginTop": "16px"
      }
    },
    {
      "id": "past",
      "type": "section",
      "visibleWhen": "{{length(item) > 0}}",
      "props": {
        "paddingY": 24,
        "paddingX": 0,
        "gap": 12
      },
      "children": [
        {
          "id": "past-h",
          "type": "heading",
          "props": {
            "text": "Its last loans",
            "level": "h2"
          },
          "style": {
            "fontSize": "var(--pw-font-size-xl)"
          }
        },
        {
          "id": "past-t",
          "type": "table",
          "props": {
            "data": "{{loans}}",
            "compact": true,
            "phoneLayout": "cards",
            "loadingWhen": "{{__loading.loans}}",
            "emptyText": "Nobody has borrowed it yet.",
            "columns": [
              {
                "key": "borrower",
                "header": "Who"
              },
              {
                "key": "borrowedAt",
                "header": "Borrowed",
                "type": "date"
              },
              {
                "key": "dueBack",
                "header": "Back by",
                "type": "date"
              },
              {
                "key": "status",
                "header": "Now",
                "type": "badge",
                "badgeLabelMap": {
                  "out": "Out",
                  "returned": "Returned"
                },
                "badgeColorMap": {
                  "out": "warning",
                  "returned": "success"
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "capabilities": [
    {
      "capability": "platform/persistence",
      "required": false,
      "config": {
        "dataSources": [
          {
            "id": "item",
            "kind": "entity",
            "entityType": "Equipment",
            "notFoundWhenEmpty": true,
            "query": {
              "filter": {
                "field": "id",
                "operator": "eq",
                "value": "{{state.id}}"
              }
            }
          },
          {
            "id": "openLoan",
            "kind": "entity",
            "entityType": "Loan",
            "query": {
              "filter": {
                "and": [
                  {
                    "field": "equipment",
                    "operator": "eq",
                    "value": "{{state.id}}"
                  },
                  {
                    "field": "status",
                    "operator": "eq",
                    "value": "out"
                  }
                ]
              },
              "sort": [
                {
                  "field": "borrowedAt",
                  "direction": "desc"
                }
              ],
              "pagination": {
                "limit": 1
              }
            }
          },
          {
            "id": "loans",
            "kind": "entity",
            "entityType": "Loan",
            "query": {
              "filter": {
                "field": "equipment",
                "operator": "eq",
                "value": "{{state.id}}"
              },
              "sort": [
                {
                  "field": "borrowedAt",
                  "direction": "desc"
                }
              ],
              "pagination": {
                "limit": 5
              }
            }
          },
          {
            "id": "newLoan",
            "kind": "entity",
            "entityType": "Loan"
          }
        ],
        "initialState": {
          "section": "/",
          "id": "",
          "due": "",
          "note": "",
          "borrowing": false,
          "borrowed": false,
          "borrowFailed": false,
          "borrowReason": "",
          "returning": false,
          "returned": false,
          "markFailed": false,
          "markReason": ""
        },
        "urlState": [
          "id"
        ],
        "behaviors": [
          {
            "id": "borrow-clears-return",
            "event": "form:submit",
            "targetBlockId": "borrow-form",
            "actions": [
              {
                "type": "setState",
                "key": "returned",
                "value": false
              }
            ]
          }
        ]
      }
    },
    {
      "capability": "platform/entities",
      "required": false,
      "config": {
        "formBindings": [
          {
            "formId": "borrow-form",
            "sourceId": "newLoan",
            "method": "POST",
            "statusKeys": {
              "loading": "borrowing",
              "success": "borrowed",
              "error": "borrowFailed",
              "reason": "borrowReason"
            }
          }
        ]
      }
    }
  ],
  "knowledge": {
    "purpose": "One piece of kit by the id in the address: what it is and where it lives, then borrow it (a Loan record) or mark it returned (its open Loan closed), and its last loans.",
    "laws": [
      "Borrowing creates a Loan; the server stamps who (owner, borrower name) and when; the page sends only the item, the date and the note",
      "The item is out while it has an open Loan; the Equipment record never changes",
      "Only the borrower (update own) or the keeper role closes a loan; the button shows only to them, and the server enforces it",
      "Equipment is read-only to the team; only the keeper role writes it",
      "An unknown id draws the not-found page at the same address"
    ],
    "patternsExercised": [
      "page-header",
      "form-card",
      "key-value-list"
    ]
  }
}
