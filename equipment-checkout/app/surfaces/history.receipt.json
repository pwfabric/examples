{
  "schemaVersion": "1.0.0",
  "id": "history",
  "version": "1.0.0",
  "kind": "surface",
  "appearance": {
    "use": "theme-equipment-checkout"
  },
  "title": "History",
  "description": "Every loan of the team’s equipment, newest first: who took what, when it is due back and when it came back.",
  "category": "app",
  "tags": [
    "equipment",
    "team",
    "loans"
  ],
  "blocks": [
    {
      "id": "head",
      "type": "section",
      "props": {
        "paddingY": {
          "xs": 20,
          "md": 28
        },
        "paddingX": 0,
        "gap": 6
      },
      "children": [
        {
          "id": "head-h",
          "type": "heading",
          "props": {
            "text": "History",
            "level": "h1"
          }
        },
        {
          "id": "head-t",
          "type": "text",
          "props": {
            "content": "Every loan, newest first.",
            "color": "var(--pw-color-text-muted)"
          }
        }
      ]
    },
    {
      "id": "show",
      "type": "segmented-control",
      "props": {
        "label": "Show",
        "options": [
          {
            "label": "All loans",
            "value": ""
          },
          {
            "label": "Still out",
            "value": "out"
          },
          {
            "label": "Returned",
            "value": "returned"
          }
        ],
        "value": "{{state.show}}",
        "stateKey": "show"
      },
      "style": {
        "alignSelf": "flex-start"
      }
    },
    {
      "id": "history-err",
      "type": "container",
      "props": {
        "padding": 0,
        "direction": "column",
        "gap": 12,
        "align": "start"
      },
      "visibleWhen": "{{!!__errors.history}}",
      "children": [
        {
          "id": "history-err-a",
          "type": "alert",
          "props": {
            "variant": "error",
            "title": "{{__errors.history == 'forbidden' ? 'Your account is not on the team list' : 'The history did not load'}}",
            "message": "{{__errors.history == 'forbidden' ? 'Ask the office manager to add you to the team, then sign in again.' : 'Check your connection and try again.'}}"
          }
        },
        {
          "id": "history-err-b",
          "type": "button",
          "props": {
            "label": "Try again",
            "variant": "outline",
            "icon": "refresh-cw",
            "action": {
              "type": "refresh",
              "sourceId": "history"
            }
          },
          "visibleWhen": "{{__errors.history != 'forbidden'}}"
        }
      ]
    },
    {
      "id": "hist-wait",
      "type": "container",
      "props": {
        "padding": 0,
        "direction": "column",
        "gap": 8
      },
      "visibleWhen": "{{__loading.history && length(history) == 0}}",
      "style": {
        "marginTop": "16px"
      },
      "children": [
        {
          "id": "hist-wait-k",
          "type": "skeleton",
          "props": {
            "variant": "rectangle",
            "width": "100%",
            "height": 64,
            "count": 4
          }
        }
      ]
    },
    {
      "id": "rows",
      "type": "repeater",
      "repeat": "{{history}}",
      "visibleWhen": "{{!__errors.history}}",
      "props": {
        "items": "{{history}}",
        "layout": "row",
        "gap": 0
      },
      "style": {
        "marginTop": "16px",
        "borderTop": "1px solid var(--pw-color-border)"
      },
      "children": [
        {
          "id": "row",
          "type": "container",
          "props": {
            "padding": 0,
            "direction": {
              "xs": "column",
              "md": "row"
            },
            "gap": {
              "xs": 4,
              "md": 16
            },
            "align": {
              "xs": "start",
              "md": "center"
            }
          },
          "style": {
            "paddingBlock": "12px",
            "borderBottom": "1px solid var(--pw-color-border)"
          },
          "children": [
            {
              "id": "row-what",
              "type": "container",
              "props": {
                "padding": 0,
                "direction": "column",
                "gap": 2
              },
              "style": {
                "flex": "1 1 0",
                "minWidth": "0"
              },
              "children": [
                {
                  "id": "row-name",
                  "type": "link",
                  "props": {
                    "text": "{{find(kit, 'id', item.equipment).name}} ({{find(kit, 'id', item.equipment).tag}})",
                    "href": "/item?id={{item.equipment}}",
                    "fontWeight": "semibold",
                    "color": "var(--pw-color-text)",
                    "underline": "hover"
                  }
                },
                {
                  "id": "row-when",
                  "type": "text",
                  "props": {
                    "content": "{{item.borrower}} · borrowed {{date(item.borrowedAt)}} · back by {{date(item.dueBack)}}{{item.status == 'returned' ? ' · returned ' + date(item.returnedAt) : ''}}",
                    "color": "var(--pw-color-text-muted)"
                  },
                  "style": {
                    "fontSize": "var(--pw-font-size-sm)"
                  }
                },
                {
                  "id": "row-note",
                  "type": "text",
                  "props": {
                    "content": "{{item.note}}",
                    "color": "var(--pw-color-text-muted)"
                  },
                  "style": {
                    "fontSize": "var(--pw-font-size-sm)",
                    "fontStyle": "italic"
                  },
                  "visibleWhen": "{{!!item.note}}"
                }
              ]
            },
            {
              "id": "row-now",
              "type": "badge",
              "props": {
                "text": "{{item.status == 'returned' ? 'Returned' : (item.dueBack < today() ? 'Overdue' : 'Out')}}",
                "status": "{{item.status == 'returned' ? 'returned' : (item.dueBack < today() ? 'overdue' : 'out')}}",
                "variantMap": {
                  "returned": "success",
                  "out": "warning",
                  "overdue": "error"
                },
                "size": "sm"
              },
              "style": {
                "flex": "0 0 auto"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "hist-none",
      "type": "container",
      "props": {
        "padding": 0,
        "direction": "column",
        "gap": 6
      },
      "visibleWhen": "{{length(history) == 0 && !__loading.history && !__errors.history}}",
      "style": {
        "marginTop": "16px"
      },
      "children": [
        {
          "id": "hist-none-t",
          "type": "text",
          "props": {
            "content": "{{state.show == 'out' ? 'Everything is back in the cupboard.' : (state.show == 'returned' ? 'Nothing has been returned yet.' : 'Nobody has borrowed anything yet.')}}",
            "color": "var(--pw-color-text-muted)"
          }
        }
      ]
    }
  ],
  "capabilities": [
    {
      "capability": "platform/persistence",
      "required": false,
      "config": {
        "dataSources": [
          {
            "id": "history",
            "kind": "entity",
            "entityType": "Loan",
            "query": {
              "filter": {
                "field": "status",
                "operator": "eq",
                "value": "{{state.show}}"
              },
              "sort": [
                {
                  "field": "borrowedAt",
                  "direction": "desc"
                }
              ]
            }
          },
          {
            "id": "kit",
            "kind": "entity",
            "entityType": "Equipment"
          }
        ],
        "initialState": {
          "section": "/history",
          "show": ""
        },
        "urlState": [
          "show"
        ]
      }
    }
  ],
  "knowledge": {
    "purpose": "Who took what and whether it came back: every Loan record, newest first, narrowed to those still out or returned.",
    "laws": [
      "Each equipment name links to its page; the name is read from the Equipment record, never stored on the loan",
      "Who borrowed is the name the server stamped on the loan",
      "On a phone each row stacks"
    ],
    "patternsExercised": [
      "data-table"
    ]
  }
}
