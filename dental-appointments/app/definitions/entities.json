        },
        {
          "name": "name",
          "type": "text",
          "required": true
        },
        {
          "name": "callName",
          "type": "text",
          "required": true
        },
        {
          "name": "role",
          "type": "text",
          "required": true
        },
        {
          "name": "about",
          "type": "text",
          "required": true
        },
        {
          "name": "days",
          "type": "text",
          "required": true
        },
        {
          "name": "languages",
          "type": "text",
          "required": true
        },
        {
          "name": "image",
          "type": "text",
          "required": true
        },
        {
          "name": "imageAlt",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "typeId": "AppointmentRequest",
      "displayName": "Appointment request",
      "fields": [
        {
          "name": "name",
          "type": "text",
          "required": true
        },
        {
          "name": "phone",
          "type": "text",
          "required": true
        },
        {
          "name": "email",
          "type": "email"
        },
        {
          "name": "service",
          "type": "relation",
          "targetTypeId": "Service",
          "required": true
        },
        {
          "name": "dentist",
          "type": "relation",
          "targetTypeId": "Dentist"
        },
        {
          "name": "day",
          "type": "date",
          "required": true
        },
        {
          "name": "time",
          "type": "enum",
          "values": [
            "morning",
            "afternoon"
          ],
          "required": true
        },
        {
          "name": "note",
          "type": "text"
        },
        {
          "name": "consent",
          "type": "boolean",
          "required": true,
          "mustBe": true
        },
        {
          "name": "status",
          "type": "enum",
          "values": [
            "new",
            "booked",
            "declined"
          ],
          "server": {
            "default": "new"
          }
        },
        {
          "name": "sentAt",
          "type": "date",
          "server": "createdAt"
        }
      ]
    }
  ]
