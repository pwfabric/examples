{
  "blocks": [
    {
      "id": "nav",
      "type": "navbar",
      "props": {
        "logoSrc": "pwpack/media/logo.svg",
        "logoText": "Example Dental Clinic",
        "logoHref": "/",
        "alignment": "right",
        "links": [
          {
            "label": "Services",
            "href": "/"
          },
          {
            "label": "Dentists",
            "href": "/dentists"
          }
        ],
        "showCTA": true,
        "ctaLabel": "Request an appointment",
        "ctaHref": "/request"
      },
      "layout": {
        "widthScope": {
          "xs": "viewport"
        }
      }
    },
    {
      "id": "main",
      "type": "container",
      "props": {
        "direction": "column",
        "landmark": "main"
      },
      "children": [
        {
          "type": "pw:page"
        }
      ],
      "style": {
        "width": "100%",
        "maxWidth": "var(--pw-layout-container-max-width, 1120px)",
        "marginInline": "auto",
        "paddingInline": "max(16px, var(--pw-layout-surface-padding, 24px))",
        "boxSizing": "border-box",
        "--pw-section-inset": "0px"
      }
    },
    {
      "id": "foot",
      "type": "section",
      "props": {
        "landmark": "footer",
        "paddingY": 32,
        "paddingX": 0,
        "gap": 0,
        "backgroundColor": "var(--pw-color-secondary)"
      },
      "children": [
        {
          "id": "foot-in",
          "type": "container",
          "props": {
            "direction": "column",
            "gap": 16,
            "padding": 0
          },
          "children": [
            {
              "id": "foot-row",
              "type": "container",
              "props": {
                "direction": "row",
                "gap": 24,
                "padding": 0,
                "wrap": true,
                "align": "start",
                "justify": "between"
              },
              "children": [
                {
                  "id": "foot-where",
                  "type": "container",
                  "props": {
                    "direction": "column",
                    "gap": 4,
                    "padding": 0
                  },
                  "children": [
                    {
                      "id": "foot-name",
                      "type": "text",
                      "props": {
                        "content": "Example Dental Clinic",
                        "fontWeight": "bold"
                      }
                    },
                    {
                      "id": "foot-addr",
                      "type": "text",
                      "props": {
                        "content": "7 Harbour Street, Exampleton · 01632 960 214",
                        "color": "var(--pw-color-text-muted)"
                      }
                    },
                    {
                      "id": "foot-hours",
                      "type": "text",
                      "props": {
                        "content": "Monday to Friday 8:30–18:00 · Saturday 9:00–13:00",
                        "color": "var(--pw-color-text-muted)"
                      }
                    }
                  ],
                  "style": {
                    "flex": "1 1 300px",
                    "minWidth": "0"
                  }
                },
                {
                  "id": "foot-tools",
                  "type": "container",
                  "props": {
                    "direction": "column",
                    "gap": 10,
                    "padding": 0,
                    "align": "start"
                  },
                  "children": [
                    {
                      "id": "foot-scheme",
                      "type": "theme-toggle",
                      "props": {
                        "showLabels": true
                      }
                    },
                    {
                      "id": "foot-reception",
                      "type": "link",
                      "props": {
                        "href": "/reception",
                        "text": "Reception sign-in",
                        "underline": "always",
                        "fontSize": 14
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "foot-legal",
              "type": "text",
              "props": {
                "content": "© 2026 Example Dental Clinic. A fictional clinic in an example app.",
                "color": "var(--pw-color-text-muted)"
              },
              "style": {
                "fontSize": "var(--pw-font-size-xs)"
              }
            }
          ],
          "style": {
            "width": "100%",
            "maxWidth": "var(--pw-layout-container-max-width, 1120px)",
            "marginInline": "auto",
            "paddingInline": "max(16px, var(--pw-layout-surface-padding, 24px))",
            "boxSizing": "border-box"
          }
        }
      ],
      "layout": {
        "widthScope": {
          "xs": "viewport"
        }
      }
    }
  ],
  "knowledge": {
    "purpose": "The clinic’s one shell: a top bar (Services, Dentists, and the Request an appointment button that marks its page), the page, and a footer with the address, the hours, the colour-scheme choice and reception’s way in.",
    "patternsExercised": [
      "shell-topnav"
    ]
  }
}
