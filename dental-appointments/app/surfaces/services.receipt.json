{
  "schemaVersion": "1.0.0",
  "id": "services",
  "version": "1.0.0",
  "kind": "surface",
  "title": "Example Dental Clinic — dentists in Exampleton",
  "titleTemplate": false,
  "description": "Check-ups, hygienist visits, fillings and emergency appointments at Example Dental Clinic on Harbour Street, Exampleton. Request an appointment online and reception calls you back.",
  "blocks": [
    {
      "id": "hero",
      "type": "container",
      "props": {
        "direction": "row",
        "gap": 32,
        "padding": 0,
        "wrap": true,
        "align": "center"
      },
      "children": [
        {
          "id": "hero-copy",
          "type": "container",
          "props": {
            "direction": "column",
            "gap": 16,
            "padding": 0
          },
          "children": [
            {
              "id": "hero-t",
              "type": "heading",
              "props": {
                "text": "A dentist in Exampleton who calls you back",
                "level": "h1"
              }
            },
            {
              "id": "hero-s",
              "type": "text",
              "props": {
                "content": "Tell us what you need and when suits you. Reception calls you within one working day to fix a time — no account, no app to install.",
                "color": "var(--pw-color-text-muted)"
              }
            },
            {
              "id": "hero-cta",
              "type": "container",
              "props": {
                "direction": "row",
                "gap": 12,
                "padding": 0,
                "wrap": true,
                "align": "center"
              },
              "children": [
                {
                  "id": "hero-request",
                  "type": "button",
                  "props": {
                    "label": "Request an appointment",
                    "href": "/request",
                    "variant": "primary",
                    "size": "large",
                    "icon": "calendar"
                  }
                },
                {
                  "id": "hero-team",
                  "type": "button",
                  "props": {
                    "label": "Meet the dentists",
                    "href": "/dentists",
                    "variant": "outline",
                    "size": "large"
                  }
                }
              ]
            },
            {
              "id": "hero-pain",
              "type": "text",
              "props": {
                "content": "In pain today? Call 01632 960 214 — we keep time free every morning.",
                "fontWeight": "semibold"
              }
            }
          ],
          "style": {
            "flex": "1 1 340px",
            "minWidth": "0"
          }
        },
        {
          "id": "hero-pic",
          "type": "image",
          "props": {
            "src": "pwpack/media/clinic.svg",
            "alt": "The clinic’s treatment room: a teal chair under a lamp, a desk with a screen, a plant by the window",
            "width": 640,
            "height": 360,
            "aspectRatio": "16/9",
            "objectFit": "cover",
            "borderRadius": "var(--pw-border-radius-lg)",
            "priority": true
          },
          "style": {
            "flex": "1 1 340px",
            "maxWidth": "100%",
            "height": "auto"
          }
        }
      ],
      "style": {
        "paddingTop": "32px",
        "paddingBottom": "24px"
      }
    },
    {
      "id": "what",
      "type": "container",
      "props": {
        "direction": "column",
        "gap": 16,
        "padding": 0
      },
      "children": [
        {
          "id": "what-t",
          "type": "heading",
          "props": {
            "text": "What we do",
            "level": "h2"
          }
        },
        {
          "id": "services-err",
          "type": "alert",
          "props": {
            "variant": "error",
            "title": "The services did not load",
            "message": "Check your connection and try again, or call us on 01632 960 214."
          },
          "visibleWhen": "{{!!__errors.services}}"
        },
        {
          "id": "services-retry",
          "type": "button",
          "props": {
            "label": "Try again",
            "variant": "outline",
            "icon": "refresh-cw",
            "action": {
              "type": "refresh",
              "sourceId": "services"
            }
          },
          "visibleWhen": "{{!!__errors.services}}",
          "style": {
            "alignSelf": "flex-start"
          }
        },
        {
          "id": "what-wait",
          "type": "grid",
          "props": {
            "columns": 3,
            "columnsXs": 1,
            "gap": 16
          },
          "children": [
            {
              "id": "what-wait-1",
              "type": "skeleton",
              "props": {
                "variant": "card",
                "height": 200
              }
            },
            {
              "id": "what-wait-2",
              "type": "skeleton",
              "props": {
                "variant": "card",
                "height": 200
              }
            },
            {
              "id": "what-wait-3",
              "type": "skeleton",
              "props": {
                "variant": "card",
                "height": 200
              }
            }
          ],
          "visibleWhen": "{{__loading.services && length(services) == 0}}"
        },
        {
          "id": "what-grid",
          "type": "grid",
          "props": {
            "columns": 3,
            "columnsXs": 1,
            "gap": 16
          },
          "children": [
            {
              "id": "svc",
              "type": "card",
              "props": {
                "padding": 20,
                "gap": 10,
                "align": "stretch"
              },
              "children": [
                {
                  "id": "svc-icon",
                  "type": "icon",
                  "props": {
                    "name": "{{item.icon}}",
                    "size": 28,
                    "color": "var(--pw-color-primary)"
                  }
                },
                {
                  "id": "svc-name",
                  "type": "heading",
                  "props": {
                    "text": "{{item.name}}",
                    "level": "h3"
                  }
                },
                {
                  "id": "svc-sum",
                  "type": "text",
                  "props": {
                    "content": "{{item.summary}}",
                    "color": "var(--pw-color-text-muted)"
                  },
                  "style": {
                    "flex": "1 1 auto"
                  }
                },
                {
                  "id": "svc-meta",
                  "type": "text",
                  "props": {
                    "content": "{{item.minutes}} min · {{item.priceFrom > 0 ? 'from £' + item.priceFrom : 'No charge'}}",
                    "fontWeight": "semibold"
                  }
                },
                {
                  "id": "svc-go",
                  "type": "button",
                  "props": {
                    "label": "Request this",
                    "href": "/request?service={{item.id}}",
                    "variant": "outline",
                    "icon": "arrow-right",
                    "iconPosition": "right",
                    "fullWidth": true
                  }
                }
              ]
            }
          ],
          "repeat": "{{services}}",
          "visibleWhen": "{{length(services) > 0}}"
        }
      ],
      "style": {
        "paddingBottom": "32px"
      }
    },
    {
      "id": "how",
      "type": "container",
      "props": {
        "direction": "column",
        "gap": 12,
        "padding": 0
      },
      "children": [
        {
          "id": "how-t",
          "type": "heading",
          "props": {
            "text": "How a request works",
            "level": "h2"
          }
        },
        {
          "id": "how-steps",
          "type": "grid",
          "props": {
            "columns": 3,
            "columnsXs": 1,
            "gap": 16
          },
          "children": [
            {
              "id": "how-1",
              "type": "container",
              "props": {
                "direction": "row",
                "gap": 12,
                "padding": 0,
                "wrap": false,
                "align": "start",
                "keepRow": true
              },
              "children": [
                {
                  "id": "how-1-n",
                  "type": "badge",
                  "props": {
                    "text": "1",
                    "variant": "primary",
                    "rounded": true,
                    "size": "lg"
                  }
                },
                {
                  "id": "how-1-c",
                  "type": "container",
                  "props": {
                    "direction": "column",
                    "gap": 4,
                    "padding": 0
                  },
                  "children": [
                    {
                      "id": "how-1-t",
                      "type": "heading",
                      "props": {
                        "text": "Send the form",
                        "level": "h3"
                      }
                    },
                    {
                      "id": "how-1-s",
                      "type": "text",
                      "props": {
                        "content": "Pick a service, a day and morning or afternoon. It takes a minute.",
                        "color": "var(--pw-color-text-muted)"
                      }
                    }
                  ],
                  "style": {
                    "flex": "1 1 0",
                    "minWidth": "0"
                  }
                }
              ]
            },
            {
              "id": "how-2",
              "type": "container",
              "props": {
                "direction": "row",
                "gap": 12,
                "padding": 0,
                "wrap": false,
                "align": "start",
                "keepRow": true
              },
              "children": [
                {
                  "id": "how-2-n",
                  "type": "badge",
                  "props": {
                    "text": "2",
                    "variant": "primary",
                    "rounded": true,
                    "size": "lg"
                  }
                },
                {
                  "id": "how-2-c",
                  "type": "container",
                  "props": {
                    "direction": "column",
                    "gap": 4,
                    "padding": 0
                  },
                  "children": [
                    {
                      "id": "how-2-t",
                      "type": "heading",
                      "props": {
                        "text": "Reception calls you",
                        "level": "h3"
                      }
                    },
                    {
                      "id": "how-2-s",
                      "type": "text",
                      "props": {
                        "content": "Within one working day, to agree a time with the dentist you asked for.",
                        "color": "var(--pw-color-text-muted)"
                      }
                    }
                  ],
                  "style": {
                    "flex": "1 1 0",
                    "minWidth": "0"
                  }
                }
              ]
            },
            {
              "id": "how-3",
              "type": "container",
              "props": {
                "direction": "row",
                "gap": 12,
                "padding": 0,
                "wrap": false,
                "align": "start",
                "keepRow": true
              },
              "children": [
                {
                  "id": "how-3-n",
                  "type": "badge",
                  "props": {
                    "text": "3",
                    "variant": "primary",
                    "rounded": true,
                    "size": "lg"
                  }
                },
                {
                  "id": "how-3-c",
                  "type": "container",
                  "props": {
                    "direction": "column",
                    "gap": 4,
                    "padding": 0
                  },
                  "children": [
                    {
                      "id": "how-3-t",
                      "type": "heading",
                      "props": {
                        "text": "Come in",
                        "level": "h3"
                      }
                    },
                    {
                      "id": "how-3-s",
                      "type": "text",
                      "props": {
                        "content": "Harbour Street, two minutes from the bus station. Arrive five minutes early.",
                        "color": "var(--pw-color-text-muted)"
                      }
                    }
                  ],
                  "style": {
                    "flex": "1 1 0",
                    "minWidth": "0"
                  }
                }
              ]
            }
          ]
        }
      ],
      "style": {
        "paddingBottom": "40px"
      }
    }
  ],
  "capabilities": [
    {
      "capability": "platform/persistence",
      "config": {
        "dataSources": [
          {
            "id": "services",
            "kind": "entity",
            "entityType": "Service",
            "query": {
              "sort": [
                {
                  "field": "rank",
                  "direction": "asc"
                }
              ]
            }
          }
        ]
      }
    }
  ],
  "knowledge": {
    "purpose": "What the clinic does and how to ask for an appointment: every service from the clinic’s records, each with its time and starting price and a way straight into the request form.",
    "laws": [
      "Each service links to the form with that service chosen (?service=<id>)",
      "A service with no charge says so instead of a price",
      "While the services load, card skeletons hold their place; a failed read says so and offers a retry"
    ],
    "patternsExercised": [
      "hero-split",
      "card-grid",
      "steps"
    ]
  }
}
