{
  "schemaVersion": "1.0.0",
  "id": "sign-in",
  "version": "1.0.0",
  "kind": "surface",
  "title": "Reception sign-in",
  "description": "Reception’s sign-in at Example Dental Clinic.",
  "blocks": [
    {
      "id": "in",
      "type": "container",
      "props": {
        "direction": "column",
        "gap": 16,
        "padding": 0
      },
      "children": [
        {
          "id": "in-head",
          "type": "section",
          "props": {
            "paddingY": 32,
            "gap": 8,
            "textAlign": "left"
          },
          "children": [
            {
              "id": "in-head-t",
              "type": "heading",
              "props": {
                "text": "Reception sign-in",
                "level": "h1"
              }
            },
            {
              "id": "in-head-s",
              "type": "text",
              "props": {
                "content": "For the clinic’s reception. Patients do not need an account: ask for an appointment instead.",
                "color": "var(--pw-color-text-muted)"
              }
            }
          ],
          "style": {
            "paddingBottom": "8px"
          }
        },
        {
          "id": "in-form",
          "type": "form",
          "props": {
            "submitLabel": "Sign in",
            "onSubmitAction": {
              "type": "auth:signIn"
            },
            "gap": 14
          },
          "children": [
            {
              "id": "in-email",
              "type": "input",
              "props": {
                "name": "email",
                "type": "email",
                "label": "E-mail",
                "autocomplete": "username",
                "required": true
              }
            },
            {
              "id": "in-password",
              "type": "input",
              "props": {
                "name": "password",
                "type": "password",
                "label": "Password",
                "autocomplete": "current-password",
                "required": true
              }
            }
          ],
          "style": {
            "maxWidth": "420px"
          }
        },
        {
          "id": "in-refused",
          "type": "alert",
          "props": {
            "variant": "error",
            "title": "Not signed in",
            "message": "{{__auth.error == 'network' ? 'Check your connection and try again.' : 'That e-mail and password do not match a reception account.'}}"
          },
          "visibleWhen": "{{!!__auth.error}}",
          "style": {
            "maxWidth": "420px"
          }
        },
        {
          "id": "in-back",
          "type": "link",
          "props": {
            "href": "/request",
            "text": "Request an appointment instead",
            "underline": "always"
          }
        }
      ],
      "style": {
        "paddingBottom": "40px"
      }
    }
  ],
  "knowledge": {
    "purpose": "The app’s own sign-in screen: e-mail and password, a refusal in the app’s words, and the way back for a visitor who came here by mistake."
  }
}
