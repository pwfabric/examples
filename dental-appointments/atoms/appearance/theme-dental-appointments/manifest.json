      "easingBounce": "cubic-bezier(0.68, -0.55, 0.27, 1.55)"
    },
    "layout": {
      "gap": "0px",
      "padding": "0px",
      "containerMaxWidth": "1120px",
      "gridGap": "24px",
      "sectionPaddingY": "clamp(2.5rem, 5vw, 4rem)",
      "sectionPaddingX": "clamp(1rem, 3vw, 1.5rem)"
    },
    "focus": {
      "ringColor": "#1a8a80",
      "ringWidth": "2px",
      "ringOffset": "2px"
    },
    "zIndex": {
      "sticky": 150,
      "nav": 200,
      "dropdown": 300,
      "drawer": 400,
      "modal": 500,
      "toast": 540
    },
    "fonts": [
      {
        "family": "Figtree",
        "fallback": "sans-serif",
        "files": [
          {
            "src": "media/fonts/figtree-latin-ext.woff2",
            "weight": "400 800",
            "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
          },
          {
            "src": "media/fonts/figtree-latin.woff2",
            "weight": "400 800",
            "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
          }
        ]
      }
    ]
  },
  "knowledge": {
    "purpose": "Example Dental Clinic's own look: mint and teal, calm and clear, for patients booking a visit and for reception handling requests.",
    "useCases": [
      "Every page of the Example Dental Clinic app"
    ],
    "composesWith": [
      "platform/persistence",
      "platform/entities"
    ],
    "antiPatterns": [
      "Pinning colours in block props — the clinic tokens already cascade"
    ]
  },
  "darkTheme": {
    "colors": {
      "primary": "#7dd3c6",
      "secondary": "#173230",
      "accent": "#1b3a37",
      "background": "#0b1918",
      "card": "#122624",
      "text": "#e4f3f0",
      "textMuted": "#a3c0bb",
      "border": "#2a4643",
      "error": "#f2a49c",
      "success": "#9fd8ae",
      "warning": "#f0c36a",
      "info": "#9cc8ea",
      "textOnPrimary": "#062220"
