{
  "id": "theme-dental-appointments",
  "kind": "ui-appearance",
  "version": "1.0.0",
  "category": "ui",
  "name": "Example Dental Clinic",
  "state": "stable",
  "description": "Clean mint ground, deep teal ink and buttons, soft corners and calm, open type for booking a visit.",
  "tags": [
    "theme",
    "appearance",
    "light",
    "dark"
  ],
  "theme": {
    "colors": {
      "primary": "#0d6660",
      "secondary": "#e2f1ee",
      "accent": "#d8eee9",
      "background": "#f4f9f8",
      "card": "#ffffff",
      "text": "#102a28",
      "textMuted": "#4a6461",
      "border": "#d3e3e0",
      "error": "#b3261e",
      "success": "#1f6b3a",
      "warning": "#8a5a00",
      "info": "#245f8a",
      "textOnPrimary": "#ffffff"
    },
    "border": {
      "radius": "12px",
      "width": "1px",
      "style": "solid",
      "radiusLarge": "16px",
      "radiusSmall": "8px",
      "radiusXl": "22px",
      "radius2xl": "28px",
      "radiusFull": "9999px"
    },
    "typography": {
      "fontFamily": "Figtree, ui-sans-serif, system-ui, sans-serif",
      "headingFontFamily": "Figtree, ui-sans-serif, system-ui, sans-serif",
      "monoFontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "baseFontSize": "16px",
      "headingWeight": "700",
      "headingLineHeight": "1.25",
      "letterSpacing": "-0.005em",
      "bodyLineHeight": "1.6",
      "fontSizeSm": "14px",
      "fontSizeXs": "12.5px",
      "fontSizeLg": "18px",
      "fontSizeXl": "21px",
      "fontSize2xl": "25px",
      "fontSize3xl": "30px",
      "fontSize4xl": "38px",
      "bodyWeight": "400",
      "bodyLetterSpacing": "0em"
    },
    "spacing": {
      "base": "1rem",
      "xs": "0.25rem",
      "sm": "0.5rem",
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2rem",
      "xxl": "3rem"
    },
    "shadows": {
      "card": "0 1px 3px 0 rgba(16,42,40,.07)",
      "button": "none",
      "sm": "0 1px 2px 0 rgba(0,0,0,.05)",
      "md": "0 4px 6px -1px rgba(0,0,0,.1), 0 2px 4px -2px rgba(0,0,0,.1)",
