{
  "schemaVersion": "1.0.0",
  "id": "notfound",
  "version": "1.0.0",
  "kind": "surface",
  "title": "{{t('notfound.title')}}",
  "description": "{{t('notfound.description')}}",
  "category": "content",
  "tags": [
    "menu",
    "restaurant",
    "cafe"
  ],
  "blocks": [
    {
      "id": "cafe-main",
      "type": "container",
      "props": {
        "direction": "column"
      },
      "children": [
        {
          "id": "missing",
          "type": "container",
          "props": {
            "direction": "column",
            "gap": 10,
            "align": "center",
            "padding": 32
          },
          "children": [
            {
              "id": "missing-icon",
              "type": "icon",
              "props": {
                "name": "utensils",
                "size": 36,
                "color": "var(--pw-color-text-muted)"
              }
            },
            {
              "id": "missing-title",
              "type": "heading",
              "props": {
                "text": "{{t('notfound.missing-title.text')}}",
                "level": "h1",
                "textAlign": "center"
              },
              "style": {
                "fontSize": "var(--pw-font-size-xl, 1.25rem)",
                "margin": "0"
              }
            },
            {
              "id": "missing-body",
              "type": "text",
              "props": {
                "content": "{{t('notfound.missing-body.content')}}",
                "color": "var(--pw-color-text-muted)",
                "textAlign": "center"
              }
            },
            {
              "id": "missing-cta",
              "type": "button",
              "props": {
                "label": "{{t('notFound.home')}}",
                "href": "/menu",
                "variant": "outline"
              }
            }
          ]
        }
      ]
    }
  ],
  "knowledge": {
    "purpose": "An unknown address or dish id meets an in-shell page that says so and leads back to the menu.",
    "laws": [
      "The not-found page wears the same shell as every page",
      "Its title is the page's one h1",
      "There is always one way on: the menu"
    ],
    "provenance": "Built from shell-bottombar-flow and empty-state.",
    "patternsExercised": [
      "shell-bottombar-flow",
      "empty-state"
    ]
  }
}
