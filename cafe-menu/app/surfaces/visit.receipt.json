  "knowledge": {
    "purpose": "Everything a guest needs before coming back: when it is open, where it is, how to call.",
    "laws": [
      "Hours and address are label–value rows, never prose",
      "The phone number is a call link and the map opens full size: the two things a guest does from here",
      "One callout for the one thing guests ask most",
      "The hours agree with the menu page"
    ],
    "patternsExercised": [
      "shell-bottombar-flow",
      "page-header",
      "key-value-list",
      "callout"
