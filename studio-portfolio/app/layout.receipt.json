{
  "blocks": [
    {
      "id": "shell",
      "type": "container",
      "props": {
        "padding": 0,
        "direction": "column"
      },
      "layout": {
        "widthScope": {
          "xs": "viewport"
        }
      },
      "children": [
        {
          "id": "nav",
          "type": "navbar",
          "layout": {
            "widthScope": {
              "xs": "viewport"
            }
          },
          "style": {
            "position": "sticky",
            "top": "0",
            "zIndex": "var(--pw-z-sticky, var(--pw-z-nav))"
          },
          "props": {
            "logoText": "Example Architects",
            "logoHref": "/",
            "links": [
              {
                "label": "Projects",
                "href": "/"
              },
              {
                "label": "About",
                "href": "/about"
              },
              {
                "label": "Contact",
                "href": "/contact"
              }
            ]
          }
        },
        {
          "id": "content",
          "type": "container",
          "props": {
            "padding": 0,
            "direction": "column",
            "landmark": "main"
          },
          "style": {
            "width": "100%",
            "maxWidth": "var(--pw-layout-container-max-width, 1200px)",
            "marginInline": "auto",
            "paddingInline": "max(16px, var(--pw-layout-surface-padding, 24px))",
            "boxSizing": "border-box",
            "--pw-section-inset": "0px",
            "paddingBottom": "48px"
          },
          "children": [
            {
              "type": "pw:page"
            }
          ]
        },
        {
          "id": "foot",
          "type": "container",
          "props": {
            "padding": 0,
            "direction": "column",
            "landmark": "footer",
            "gap": 0
          },
          "style": {
            "width": "100%",
            "maxWidth": "var(--pw-layout-container-max-width, 1200px)",
            "marginInline": "auto",
            "paddingInline": "max(16px, var(--pw-layout-surface-padding, 24px))",
            "boxSizing": "border-box"
          },
          "children": [
            {
              "id": "foot-row",
              "type": "container",
              "props": {
                "padding": 0,
                "direction": {
                  "xs": "column",
                  "md": "row"
                },
                "align": {
                  "xs": "start",
                  "md": "center"
                },
                "justify": "between",
                "gap": {
                  "xs": 16,
                  "md": 24
                }
              },
              "style": {
                "paddingBlock": "28px",
                "borderTop": "1px solid var(--pw-color-border)"
              },
              "children": [
                {
                  "id": "foot-text",
                  "type": "container",
                  "props": {
                    "padding": 0,
                    "direction": "column",
                    "gap": 4
                  },
                  "children": [
                    {
                      "id": "foot-c",
                      "type": "text",
                      "props": {
                        "content": "© 2026 Example Architects",
                        "color": "var(--pw-color-text-muted)"
                      },
                      "style": {
                        "fontSize": "var(--pw-font-size-sm)"
                      }
                    },
                    {
                      "id": "foot-a",
                      "type": "text",
                      "props": {
                        "content": "3 Ropewalk Lane, Exampleton · studio@example.com · 01632 960 418",
                        "color": "var(--pw-color-text-muted)"
                      },
                      "style": {
                        "fontSize": "var(--pw-font-size-sm)"
                      }
                    }
                  ]
                },
                {
                  "id": "foot-scheme",
                  "type": "theme-toggle",
                  "props": {
                    "showSystem": true,
                    "showLabels": true
                  },
                  "style": {
                    "flex": "0 0 auto"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "knowledge": {
    "purpose": "The frame every page of the studio shares: the top bar (Projects, About, Contact), the page, and the footer with the address and the colour-scheme control.",
    "laws": [
      "The navbar marks the page in view (the engine gives it the address)",
      "One colour-scheme control, in the footer"
    ],
    "patternsExercised": [
      "layout-topbar"
    ]
  }
}
