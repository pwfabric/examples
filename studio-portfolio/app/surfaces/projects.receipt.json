{
  "schemaVersion": "1.0.0",
  "id": "projects",
  "version": "1.0.0",
  "kind": "surface",
  "appearance": {
    "use": "theme-studio-portfolio"
  },
  "title": "Example Architects — buildings for people who stay",
  "titleTemplate": false,
  "description": "Example Architects designs homes, libraries, schools and workplaces in and around Exampleton. See six of our projects and start a conversation about yours.",
  "category": "content",
  "tags": [
    "architecture",
    "portfolio"
  ],
  "blocks": [
    {
      "id": "intro",
      "type": "section",
      "props": {
        "paddingY": {
          "xs": 32,
          "md": 56
        },
        "gap": 10
      },
      "children": [
        {
          "id": "intro-h",
          "type": "heading",
          "props": {
            "text": "Buildings for people who stay",
            "level": "h1"
          }
        },
        {
          "id": "intro-t",
          "type": "text",
          "props": {
            "content": "We are a studio of eleven architects in Exampleton. We design homes, libraries, schools and workplaces that are cheap to run, good to grow old in, and built from what the place already has.",
            "color": "var(--pw-color-text-muted)"
          },
          "style": {
            "maxWidth": "62ch",
            "fontSize": "var(--pw-font-size-lg)"
          }
        }
      ]
    },
    {
      "id": "wait",
      "type": "container",
      "props": {
        "padding": 0,
        "direction": "column",
        "gap": 12
      },
      "visibleWhen": "{{__loading.projects && length(projects) == 0}}",
      "children": [
        {
          "id": "wait-s",
          "type": "spinner",
          "props": {
            "size": "sm",
            "label": "Loading the projects…",
            "variant": "muted"
          }
        },
        {
          "id": "wait-k",
          "type": "skeleton",
          "props": {
            "variant": "rectangle",
            "width": "100%",
            "height": 280,
            "count": 2
          }
        }
      ]
    },
    {
      "id": "err",
      "type": "container",
      "props": {
        "padding": 0,
        "direction": "column",
        "gap": 12,
        "align": "start"
      },
      "visibleWhen": "{{!!__errorCodes.projects}}",
      "children": [
        {
          "id": "err-a",
          "type": "alert",
          "props": {
            "variant": "error",
            "title": "The projects did not load",
            "message": "Check your connection and try again."
          }
        },
        {
          "id": "err-b",
          "type": "button",
          "props": {
            "label": "Try again",
            "variant": "outline",
            "icon": "refresh-cw",
            "action": {
              "type": "refresh",
              "sourceId": "projects"
            }
          }
        }
      ]
    },
    {
      "id": "gallery",
      "type": "repeater",
      "repeat": "{{projects}}",
      "visibleWhen": "{{!__errorCodes.projects}}",
      "props": {
        "items": "{{projects}}",
        "layout": "card",
        "columns": 3,
        "minCellWidth": {
          "xs": 260,
          "md": 320
        },
        "gap": 28
      },
      "children": [
        {
          "id": "tile",
          "type": "card",
          "props": {
            "href": "/project?id={{item.id}}",
            "padding": 0,
            "gap": 0,
            "shadow": "none",
            "borderWidth": 1
          },
          "style": {
            "overflow": "hidden",
            "height": "100%"
          },
          "states": {
            "hover": {
              "borderColor": "var(--pw-color-primary)"
            }
          },
          "children": [
            {
              "id": "tile-pic",
              "type": "image",
              "props": {
                "src": "{{item.image}}",
                "alt": "{{item.imageAlt}}",
                "aspectRatio": "3/2",
                "objectFit": "cover",
                "width": "100%",
                "borderRadius": 0
              }
            },
            {
              "id": "tile-body",
              "type": "container",
              "props": {
                "padding": 0,
                "direction": "column",
                "gap": 6
              },
              "style": {
                "padding": "18px 20px 22px"
              },
              "children": [
                {
                  "id": "tile-kind",
                  "type": "text",
                  "props": {
                    "content": "{{item.kind}} · {{item.place}} · {{item.status == 'On site' ? 'on site now' : item.year}}",
                    "color": "var(--pw-color-text-muted)"
                  },
                  "style": {
                    "fontSize": "var(--pw-font-size-sm)",
                    "letterSpacing": "0.02em"
                  }
                },
                {
                  "id": "tile-name",
                  "type": "heading",
                  "props": {
                    "text": "{{item.name}}",
                    "level": "h2"
                  },
                  "style": {
                    "fontSize": "var(--pw-font-size-xl)",
                    "margin": "0"
                  }
                },
                {
                  "id": "tile-sum",
                  "type": "text",
                  "props": {
                    "content": "{{item.summary}}",
                    "color": "var(--pw-color-text-muted)"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "none",
      "type": "container",
      "props": {
        "padding": 0,
        "direction": "column",
        "gap": 8,
        "align": "start"
      },
      "visibleWhen": "{{length(projects) == 0 && !__loading.projects && !__errorCodes.projects}}",
      "children": [
        {
          "id": "none-h",
          "type": "heading",
          "props": {
            "text": "No projects to show yet",
            "level": "h2"
          }
        },
        {
          "id": "none-t",
          "type": "text",
          "props": {
            "content": "Our portfolio is being updated. Write to us and we will send you drawings of recent work.",
            "color": "var(--pw-color-text-muted)"
          }
        },
        {
          "id": "none-b",
          "type": "button",
          "props": {
            "label": "Write to us",
            "variant": "outline",
            "href": "/contact"
          }
        }
      ]
    }
  ],
  "capabilities": [
    {
      "capability": "platform/persistence",
      "required": false,
      "config": {
        "dataSources": [
          {
            "id": "projects",
            "kind": "entity",
            "entityType": "Project",
            "query": {
              "sort": [
                {
                  "field": "rank",
                  "direction": "asc"
                }
              ]
            }
          }
        ]
      }
    }
  ],
  "knowledge": {
    "purpose": "The studio’s work at a glance: one tile per project, each tile the link to its page.",
    "laws": [
      "Every tile is a card whose href opens the project; its name is the link’s name",
      "Tiles reflow: as many per line as fit at the width the page is drawn at",
      "While the projects load a skeleton holds their place; a failed read offers a retry"
    ],
    "patternsExercised": [
      "page-header",
      "card-grid"
    ]
  }
}
