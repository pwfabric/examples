          "props": {
            "text": "About the studio",
            "level": "h1"
          }
        },
        {
          "id": "intro-t",
          "type": "text",
          "props": {
            "content": "Eleven architects and one model maker in the top floor of Ropewalk Studios, a warehouse we converted ourselves. We have worked within an hour of Exampleton since 2009.",
