{
  "id": "theme-studio-portfolio",
  "kind": "ui-appearance",
  "version": "1.0.0",
  "category": "ui",
  "name": "Example Architects",
  "state": "stable",
  "description": "Paper and ink: a warm off-white ground, near-black type, one brick-red accent, a serif for headings and square corners; a charcoal dark variant with a terracotta accent.",
  "tags": [
    "theme",
    "appearance",
    "light",
    "dark"
  ],
  "theme": {
    "colors": {
      "primary": "#a0391f",
      "secondary": "#ebe7df",
      "accent": "#efe2d8",
      "background": "#f4f2ed",
      "card": "#fbfaf7",
      "text": "#1c1c1a",
      "textMuted": "#57554f",
      "border": "#d6d1c6",
      "error": "#b3261e",
      "success": "#2f6b3f",
      "warning": "#8a5a00",
      "info": "#2f5f8a",
      "textOnPrimary": "#ffffff"
    },
    "border": {
      "radius": "4px",
      "width": "1px",
      "style": "solid",
      "radiusLarge": "6px",
      "radiusSmall": "2px",
      "radiusXl": "8px",
      "radius2xl": "10px",
      "radiusFull": "9999px"
    },
    "typography": {
      "fontFamily": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "headingFontFamily": "Newsreader, \"Iowan Old Style\", \"Palatino Linotype\", Palatino, Georgia, serif",
      "monoFontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "baseFontSize": "17px",
      "headingWeight": "500",
      "headingLineHeight": "1.15",
      "letterSpacing": "-0.01em",
      "bodyLineHeight": "1.6",
      "fontSizeSm": "15px",
      "fontSizeXs": "12px",
      "fontSizeLg": "19px",
      "fontSizeXl": "22px",
      "fontSize2xl": "28px",
      "fontSize3xl": "36px",
      "fontSize4xl": "52px",
      "bodyWeight": "400",
      "bodyLetterSpacing": "0em"
    },
    "spacing": {
      "base": "1rem",
      "xs": "0.25rem",
      "sm": "0.5rem",
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2rem",
      "xxl": "3rem"
    },
    "shadows": {
      "card": "none",
      "button": "none",
      "sm": "0 1px 2px 0 rgba(0,0,0,.05)",
      "md": "0 4px 6px -1px rgba(0,0,0,.1), 0 2px 4px -2px rgba(0,0,0,.1)",
      "lg": "0 10px 15px -3px rgba(0,0,0,.1), 0 4px 6px -4px rgba(0,0,0,.1)",
      "xl": "0 20px 25px -5px rgba(0,0,0,.1), 0 8px 10px -6px rgba(0,0,0,.1)"
    },
    "motion": {
      "durationFast": "150ms",
      "durationNormal": "200ms",
      "durationSlow": "300ms",
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
      "easingBounce": "cubic-bezier(0.68, -0.55, 0.27, 1.55)"
    },
    "layout": {
      "gap": "0px",
      "padding": "0px",
      "containerMaxWidth": "1200px",
      "gridGap": "24px",
      "sectionPaddingY": "clamp(2.5rem, 5vw, 4rem)",
      "sectionPaddingX": "clamp(1rem, 3vw, 1.5rem)"
    },
    "focus": {
      "ringColor": "#a0391f",
      "ringWidth": "2px",
      "ringOffset": "2px"
    },
    "zIndex": {
      "sticky": 150,
      "nav": 200,
      "dropdown": 300,
      "drawer": 400,
      "modal": 500,
      "toast": 540
    }
  },
  "darkTheme": {
    "colors": {
      "primary": "#e58a6c",
      "secondary": "#262624",
      "accent": "#2e2622",
      "background": "#141413",
      "card": "#1d1d1b",
      "text": "#ecebe6",
      "textMuted": "#aaa79f",
      "border": "#3a3935",
      "error": "#ff9b8a",
      "success": "#86d6a0",
      "warning": "#f5c95a",
      "info": "#9cc8ff",
      "textOnPrimary": "#1a0d08"
    }
  },
  "knowledge": {
    "purpose": "Paper and ink: a warm off-white ground, near-black type, one brick-red accent, a serif for headings and square corners; a charcoal dark variant with a terracotta accent.",
    "useCases": [
      "The pages of the Example Architects example app"
    ],
    "composesWith": [
      "platform/persistence",
      "platform/entities",
      "platform/navigation"
    ],
    "antiPatterns": [
      "Pinning colours in block props — the theme tokens already cascade"
    ]
  }
}
